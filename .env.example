NODE_ENV=development

API_PORT=3001
WEB_PORT=3000
ADMIN_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
AUTH_COOKIE_NAME=taktic_session

# ─── Session policy ──────────────────────────────────────────────────────────
#
# Two independent clocks end a session, and neither extends the other:
#
#   idle       the session is refused once this much time has passed since the
#              last request it made. Activity slides this window and nothing
#              else.
#   absolute   the session dies this long after it was created, whatever
#              happened in between. Never moved forward — there is no sliding
#              session and no session that renews itself forever.
#
# There are TWO policies of that shape, and "Beni hatırla" on a sign-in screen
# is what chooses between them. It is a policy, not a longer cookie:
#
#   ordinary       idle 30 minutes, absolute 8 hours, session cookie (dies with
#                  the browser).
#   remembered     idle 30 days, absolute 30 days, persistent cookie.
#
# The remembered idle window is separate on purpose. Sharing the ordinary one
# made the box nearly meaningless: a remembered session was indistinguishable
# from an ordinary one after half an hour of quiet, so the persistent cookie
# bought only the first thirty minutes after a browser restart. What somebody
# ticking the box is asking for is "do not make me sign in again on this
# device", and that is a longer idle window.
#
# Both are enforced on the server from Session.rememberMe, so a longer window is
# never something the browser can claim for itself. Nothing about "remember me"
# is ever written to localStorage — no password, no token, no identity. The
# cookie is the whole mechanism, and it stays HttpOnly. Signing out (or any
# server-side revoke) ends either kind immediately.
#
# The remaining three are tuning, not policy: how often an active session's
# activity mark is written (so one row does not become a write hot spot), and
# how long before the cut-off the browser offers to keep each kind of session
# alive. Two minutes suits a half-hour window; a month-long one reaches its last
# two minutes at an hour nobody is watching, so it gets a day. Each warning is
# clamped to its own idle window.
#
# Every value is a positive whole number of seconds. Anything else fails at
# boot rather than silently restoring a default nobody chose — a typo that read
# as zero would end every session on the very next request.
#
# Replaces the old SESSION_TTL_DAYS, which expressed one clock where there are
# two and had no inactivity rule at all. It is no longer read.
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_REMEMBER_ME_IDLE_TIMEOUT_SECONDS=2592000
SESSION_REMEMBER_ME_TTL_SECONDS=2592000
SESSION_TOUCH_INTERVAL_SECONDS=300
SESSION_IDLE_WARNING_SECONDS=120
SESSION_REMEMBER_ME_IDLE_WARNING_SECONDS=86400

# ─── Post-match messaging ────────────────────────────────────────────────────
#
# In-app messaging between a customer and the provider whose offer they
# accepted. There is no switch that turns it on: it follows contact sharing.
# A thread exists only where a ContactRevealEvent does, so with
# CONTACT_SHARING_ENABLED=false above no conversation can be opened at all.
#
# The limit below is per account, counted from the messages table itself, so it
# survives a restart and holds across every process behind a load balancer. Ten
# messages a minute is generous for a person and useless for a script.
MESSAGE_RATE_LIMIT_MAX=10
MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60

# ─── Where the two browser applications live ─────────────────────────────────
#
# Besides naming the panel an invitation link points at, these are what the
# API's CORS allow-list is derived from: exactly these two origins may make a
# credentialed cross-origin call, and every other Origin is answered with no
# Access-Control-Allow-Origin at all. There is no third variable to set — a
# deployment that already names its web and admin applications (here, or as
# WEB_APP_URL / ADMIN_APP_URL) needs no change.
#
# Outside NODE_ENV=production a loopback origin also admits its siblings on the
# same scheme and port — localhost, 127.0.0.1 and [::1] — so a developer who
# types either name, and the end-to-end suite, both reach the API. That
# expansion does not happen in production.
#
# Requests that carry no Origin at all — the Next processes calling
# API_INTERNAL_URL, health checks, curl — are unaffected: CORS is a browser rule
# about cross-origin reads.
ADMIN_ORIGIN=http://localhost:3002
WEB_ORIGIN=http://localhost:3000

# Where this deployment lives on the public internet.
#
# Every link the platform mails is built from it: an activation link, a password
# reset link, a request page, the logo an inbox fetches. WEB_ORIGIN above is
# still honoured, so an existing deployment needs no change; WEB_APP_URL is the
# name to prefer.
#
# It must be an https origin with no path. Unset, malformed, plain http or
# loopback all mean the same thing: this address cannot be put in front of a
# recipient, because a link to `localhost` resolves to *their* machine.
#
# It is NOT a boot condition, and never stops the API. That was the old rule and
# it was wrong by an order of magnitude: an address that is merely unusable in
# an e-mail took down authentication, the admin panel and every request and
# offer flow with it. The check now runs once per send, in the delivering
# transport. With EMAIL_TRANSPORT=resend and an unusable address here, any
# message that would carry a link or the logo is NOT sent and is recorded in
# NotificationLog as FAILED with errorCode EMAIL_PUBLIC_URL_INVALID. The one
# notification that carries no link at all (the day-7 request reminder) still
# goes out.
#
# So a local stack may keep the loopback default even with a real transport
# selected: everything works, and only the e-mails that would have carried a
# dead link are held back.
# WEB_APP_URL=https://taktick.example
#
# The web application reads the same variable (docker-compose.yml forwards it
# to the web service) for search engines: the canonical link and Open Graph
# URL on every indexable page, the `Sitemap:` line of /robots.txt and every
# row of /sitemap.xml are built from it. See "Search engine indexing" below.

# ─── Search engine indexing ──────────────────────────────────────────────────
#
# No variable of its own. A deployment is open to indexing when, and only
# when, BOTH of these already-declared values hold:
#
#   APP_ENVIRONMENT=production   the deployment's own statement (see the
#                                Turnstile section). `local`, `staging`, unset
#                                or a misspelling all mean closed.
#   WEB_APP_URL=https://…        a public https origin with no path, and not
#                                loopback — the same rule the e-mail links use.
#
# Closed means: every page carries `<meta name="robots" content="noindex,
# nofollow">`, /robots.txt is `Disallow: /` with no sitemap line, /sitemap.xml
# is empty, and no canonical link, Open Graph URL or JSON-LD is rendered at
# all — there is no origin to build one from, and a canonical pointing at
# localhost would be worse than none. A production host that has not set
# WEB_APP_URL is therefore invisible to search engines until it does, which is
# the intended failure.
#
# Open means: the home page, the category catalogue and each live category,
# each approved business's public page (/isletme/<id>), the vitrin shelf and
# each card on the air are `index, follow` on their clean paths, and nothing
# else is — every panel, form, sign-in, success and error screen stays
# noindex, and a search, filter, pagination or flow-state query string makes
# a page a noindex variant (apps/web/lib/seo-routes.ts is the list).
#
# Staging keeps its edge-level `X-Robots-Tag: noindex` header as well; the
# two layers agree. Production must NOT carry that header — it would override
# the application's `index`.

# Where the e-mail images are served from. Defaults to the web application
# above, which serves apps/web/public — set it only when the static assets sit
# behind a separate CDN host.
# EMAIL_ASSET_BASE_URL=https://cdn.taktick.example

# ─── DEPRECATED: the company footer moved into the admin panel ───────────────
#
# The legal name, the support address and the postal address printed in every
# transactional e-mail are business facts, not deployment configuration. They
# are now maintained by a SUPER_ADMIN under
#
#     Yönetim → Şirket ve E-posta
#
# and stored in the CompanySettings table, so correcting a typo in the footer
# every customer reads needs neither a redeploy nor a shell on the API host.
#
# NONE of the three variables below is required any more, and the API will not
# refuse to boot without them — refusing to start a marketplace over an
# unfinished footer was the wrong answer. What happens instead: with a real
# transport selected and the settings missing or unpublishable, the designed
# e-mails are NOT sent. Each attempt is recorded in NotificationLog as FAILED
# with errorCode EMAIL_BRANDING_INCOMPLETE, and no recipient receives a
# half-filled message. The admin screen names exactly what is missing.
#
# They are still read, once, as a fallback for a deployment that set them before
# the panel existed — and only while no CompanySettings row exists. Saving the
# form supersedes them permanently. A value that IS set must still be a valid
# e-mail address; a typo here is refused at boot rather than silently ignored.
#
# Move these into the admin panel and then delete them from your environment.
#
# SUPPORT_EMAIL is where a customer's reply is actually read. It is NOT derived
# from EMAIL_FROM and must not be set to it: the sender is a no-reply mailbox on
# the verified Resend domain, and the two are different facts.
# SUPPORT_EMAIL=destek@taktick.example
# COMPANY_LEGAL_NAME=TakTick Teknoloji A.Ş.
# COMPANY_POSTAL_ADDRESS=Kızılırmak Mah. 1443. Cad. No:12, Çankaya/Ankara

# Hides unverified requests from providers and blocks approving them.
# Keep false until a real SMS transport is configured: the console adapter only
# prints codes in development, so turning this on beforehand would strand every
# new request in an unverifiable state. Only "true"/"false" are accepted — any
# other value fails at boot rather than silently disabling the gate.
REQUIRE_PHONE_VERIFICATION=false

# Opens the two matched parties' contact details to each other once an offer is
# accepted, and records one immutable audit row per request when it happens.
#
# Off by default, and it cannot be turned on halfway: with
# CONTACT_SHARING_ENABLED=true both settings below are mandatory and the API
# refuses to boot without them. CONTACT_DISCLOSURE_URL must be https and must
# point at the published disclosure text; CONTACT_DISCLOSURE_VERSION is a short
# identifier for that text (a-z, 0-9, dot, dash, underscore, normalised to lower
# case) which is stored on every acceptance and on every audit row.
#
# This flag is a technical switch, not an approval. The checkbox the request
# form renders states only that the linked text was read — this repository does
# not contain, generate or stand in for that text, and the feature must stay off
# until approved content exists behind the URL.
#
# Requests created before their customer was shown the disclosure carry no
# acceptance and are never opened, whatever this flag says.
CONTACT_SHARING_ENABLED=false
# CONTACT_DISCLOSURE_URL=https://example.com/iletisim-paylasimi
# CONTACT_DISCLOSURE_VERSION=v1

# Outbound e-mail transport. Exactly one of: console | file-outbox | resend.
# Anything else fails at boot, and an empty value keeps the historical default
# (console, or the recording outbox when NOTIFICATION_OUTBOX_DIR is set).
#
#   console     development default. Writes the message — including the link —
#               to the application log and delivers nothing. It refuses to print
#               an action URL in production.
#   file-outbox test-only recorder for the browser suite. Requires
#               NOTIFICATION_OUTBOX_DIR and cannot exist in production.
#   resend      the real transactional transport. This is the only value that
#               puts a message in a stranger's inbox.
#
# A production process must be on `resend`: it refuses to boot on console or
# file-outbox, because either would look healthy while no customer ever receives
# an activation link.
#
# Choosing `resend` does not change whether the API starts. Two separate,
# per-message rules decide whether a designed e-mail actually goes out:
#
#   EMAIL_PUBLIC_URL_INVALID     WEB_APP_URL above is unset, http or loopback,
#                                so every link and the logo would be unusable.
#   EMAIL_BRANDING_INCOMPLETE    the company footer has not been filled in yet
#                                (Yönetim → Şirket ve E-posta).
#
# Either one holds the message back and records it FAILED in NotificationLog.
# Neither one stops the process, and neither affects auth, the admin panel or
# any request/offer flow.
EMAIL_TRANSPORT=console

# Required when (and only when) EMAIL_TRANSPORT=resend.
#
# NEVER commit a key, and never put a real one in this file — it is tracked. Set
# it in the deployment environment (or your untracked local .env) and nowhere
# else. It is read straight into one Authorization header and is never logged,
# stored, or included in an error message.
# RESEND_API_KEY=
#
# The sender. Mandatory in production, where it must be exactly the value below:
# notify.taktick.com.tr (region eu-west-1) is the verified Resend domain, and an
# address outside it is not DKIM-signed for this deployment. Outside production
# this value is also the default, so a local smoke test only needs the key.
#
# Open and click tracking are off for this domain and must stay off: these are
# transactional messages carrying single-use links, so nothing may rewrite a
# link through a redirector or embed a pixel in one.
# EMAIL_FROM=Taktick <noreply@notify.taktick.com.tr>
#
# How long one send may take before it is abandoned (1000-60000, default 10000).
# RESEND_TIMEOUT_MS=10000

# Lets the applicant behind a guest provider application take ownership of it
# through a single-use link mailed to the address on that application, and lets
# a SUPER_ADMIN re-send that link. There is deliberately no public "resend to
# this address" endpoint: it would answer whether an address has an application
# behind it.
#
# Off by default, and it cannot be turned on in production without a real,
# configured e-mail transport — the API refuses to boot otherwise. That is not a
# nicety: the link is the only proof of mailbox ownership the flow has. The
# development console adapter prints the link to the application log (and
# refuses to print it in production), and the file outbox further down is
# test-only; neither delivers anything, so EMAIL_TRANSPORT=resend with its
# credentials is what satisfies this. Turning this flag on is a separate,
# deliberate decision — configuring Resend does not turn it on.
#
# With the flag on, an anonymous application must carry a valid e-mail address,
# which is stored lower-cased. Applications submitted before that — including
# every one with no address at all — stay administrable only; nothing is
# backfilled, and an admin can correct an address and then invite it.
#
# The web app reads the same variable to decide what its forms say, so set it
# for the Next processes too.
#
# Only "true"/"false" are accepted; any other value fails at boot.
PROVIDER_CLAIM_ENABLED=false

# Which payment provider opens credit package checkouts. Exactly one of:
# mock | lemon-squeezy-test. Anything else fails at boot, and the value is never
# echoed in the error — a key pasted into the wrong variable must not end up in
# the boot log.
#
#   mock                the shipped default and the historical behaviour: an
#                       in-app checkout form, clearly labelled as a test, that
#                       settles through POST /providers/:id/package-purchases/
#                       :purchaseId/mock-pay. Collects nothing.
#   lemon-squeezy-test  Lemon Squeezy in **sandbox/test mode**. Opens a hosted
#                       checkout and loads credits only from a signature-
#                       verified webhook. Collects no real money, refuses to
#                       boot under NODE_ENV=production, and sends test_mode:true
#                       on every checkout.
#
# There is no live value, and there is no switch that creates one. Live payment
# collection is deliberately out of this build: Lemon Squeezy has not approved
# this marketplace's suitability in writing, and until it does, live mode is not
# something a deployment can opt into. Any of LEMON_SQUEEZY_LIVE_ENABLED,
# LEMON_SQUEEZY_LIVE_API_KEY, LEMON_SQUEEZY_LIVE_STORE_ID or PAYMENT_LIVE_ENABLED
# being set at all — even to "false" — stops the API at boot, as does a
# LEMON_SQUEEZY_MODE other than "test".
#
# What is being sold through this integration is provider software usage credit
# (teklif gönderme kullanım kredisi): the right to send offers inside this
# application, bought by the provider for its own account. It is not a service
# sale, and no money moves from a customer to a provider.
PAYMENT_PROVIDER=mock

# Required when (and only when) PAYMENT_PROVIDER=lemon-squeezy-test. All four
# are validated at boot and none is ever logged, stored or returned by an API.
#
# NEVER commit any of these, and never put a real one in this file — it is
# tracked. Set them in the deployment environment (or your untracked local .env)
# and nowhere else. Use credentials issued for the **sandbox/test** store.
#
# In the local Docker stack these reach the **api** container only: it is the
# only service that opens checkouts or verifies webhook signatures. The web and
# admin containers are deliberately given none of them. Uncomment the lines
# below in your own untracked .env — not here — and `docker compose up -d api`
# picks them up. Everything stays sandbox: PAYMENT_PROVIDER=lemon-squeezy-test
# is refused under NODE_ENV=production on purpose, every checkout it opens
# carries test_mode:true, and a webhook that does not say it is a test-mode
# event loads nothing.
#
# LEMON_SQUEEZY_API_KEY=<sandbox api key — never commit this>
# LEMON_SQUEEZY_STORE_ID=<numeric sandbox store id>
#
# The shared secret configured on the Lemon Squeezy webhook. It is the only
# thing separating a real settlement notice from anyone who can reach the public
# webhook URL, so the endpoint refuses every delivery whose HMAC does not match
# and writes nothing at all in that case. 16-255 printable, non-space characters.
# Never commit it.
# LEMON_SQUEEZY_WEBHOOK_SECRET=<webhook signing secret — never commit this>
#
# Which sandbox variant stands for which credit package, by package **slug** so
# the mapping survives a reseed. Not JSON: comma-separated "slug:variantId"
# pairs, where the slug is the OfferCreditPackage slug and the id is the numeric
# Lemon Squeezy variant id. It is an allow-list in both directions: an unmapped
# package cannot be checked out, and a variant may stand for exactly one
# package. The slugs below are the ones prisma/seed.ts creates:
# LEMON_SQUEEZY_VARIANT_MAP=starter-20:2058219,pro-50:2058261,business-100:2058269
#
# How long one checkout request may take before it is abandoned
# (1000-60000, default 10000).
# LEMON_SQUEEZY_TIMEOUT_MS=10000
#
# A test seam only: points the adapter at a stand-in sandbox API. Set
# automatically by the Playwright config so the browser suite never reaches
# Lemon Squeezy. It must be https unless it points at loopback, and it may not
# be set in production at all.
# LEMON_SQUEEZY_API_BASE_URL=

# Refunds the credit of an offer the customer never opened inside its window.
#
# Off unless this is exactly "true". There is no window setting here, and there
# will not be one: the window is a commercial term a super admin sets in the
# admin panel, and every offer snapshots the moment it produced. A cron
# therefore cannot refund early — a late run simply refunds on its next pass.
UNVIEWED_OFFER_REFUND_ENABLED=false
UNVIEWED_OFFER_REFUND_CRON=0 * * * *
UNVIEWED_OFFER_REFUND_LIMIT=100

# Closes APPROVED requests 14 days after their approval, and mails a single
# day-7 reminder to customers whose approved request still has no offer at all.
#
# Both default to false: they are the only writers that close a request or mail
# a customer with no human in the loop, so a half-configured environment must do
# nothing. Only "true"/"false" are accepted and the cron expressions are
# validated — a typo fails at boot rather than leaving a job silently off, or on
# a schedule nobody chose.
#
# Requests approved before the approvedAt column existed carry NULL and are
# never touched by either job, whatever these flags say.
REQUEST_EXPIRY_SCHEDULER_ENABLED=false
REQUEST_EXPIRY_SCHEDULER_CRON=15 * * * *
REQUEST_REMINDER_SCHEDULER_ENABLED=false
REQUEST_REMINDER_SCHEDULER_CRON=45 * * * *
# Requests one run of either job may touch (1–1000).
REQUEST_LIFECYCLE_SCAN_LIMIT=200

# ─── Request drafts and the client address behind them ───────────────────────
#
# A request form parked on the server while its author signs in or activates
# an account (RequestDraft). Two knobs, both optional:
#
#   REQUEST_DRAFT_MAX_ACTIVE   (API) ceiling on live drafts — consumedAt IS NULL
#                              and not yet expired — across the whole platform.
#                              Above it a new draft is refused with
#                              503 DRAFT_STORAGE_BUSY + Retry-After: 60; updating
#                              or replacing an existing draft is never refused.
#                              Positive whole number; anything else falls back
#                              to the default.
#   WEB_TRUST_PROXY            (web) whether the web server forwards the
#                              X-Forwarded-For it received to the API, verbatim.
#                              Only "true" turns it on. Off, no X-Forwarded-For
#                              is forwarded at all and the API keys the draft
#                              budget (5 per 10 minutes per client) on the web
#                              server's own address — shared, but unforgeable.
#                              Turn it on only behind an edge that writes the
#                              header, together with the API's TRUST_PROXY hop
#                              count, or a client could pick its own bucket.
REQUEST_DRAFT_MAX_ACTIVE=10000
WEB_TRUST_PROXY=false

# ─── Cloudflare Turnstile on customer-originated writes ──────────────────────
#
# Six routes ask for a Turnstile token before they do anything — creating a
# request, opening a vitrin lead, sending a phone code (either path), the
# identity pre-check and the activation link — and refuse without one: 403
# TURNSTILE_REQUIRED / TURNSTILE_FAILED, or 503 TURNSTILE_UNAVAILABLE when
# Cloudflare cannot be asked. The API alone verifies; the web only carries the
# token in one header. Rate limits, phone proofs and the identity gate all
# stay exactly as they are — this is a layer in front of them, not instead.
#
#   APP_ENVIRONMENT              (api + web) local | staging | production.
#                                The one statement a deployment makes about
#                                itself; every environment-gated behaviour
#                                reads it, and NODE_ENV is not a substitute
#                                (a local stack may run a production build).
#                                docker-compose.yml forwards it exactly as
#                                the host set it and never defaults it:
#                                undeclared is treated as production by
#                                every reader. The local stack declares
#                                itself through docker-compose.local.yml
#                                (`pnpm stack:up`), not through this file,
#                                so a copy of this file on a staging or
#                                production host can never make it local.
#                                Staging and production MUST declare
#                                themselves in their own environment.
#   TURNSTILE_MODE               (api + web) cloudflare | test | off.
#                                Unset follows APP_ENVIRONMENT: `test` on a
#                                declared local stack (and in unit-test
#                                workers), so `pnpm stack:up` boots and the
#                                forms work with no Turnstile value at all
#                                and no byte reaches Cloudflare; `cloudflare`
#                                on staging, production and any undeclared
#                                environment — the base compose file alone —
#                                where the secret, hostnames and site key are
#                                then required. `test` accepts only the
#                                deterministic tokens the web's test adapter
#                                mints; `off` lets everything through (the
#                                integration suite). Asked for explicitly,
#                                both are accepted ONLY where the default
#                                would have been `test` — staging and
#                                production refuse to boot with either.
#   TURNSTILE_SECRET_KEY         (api only, staging/prod) the widget's secret
#                                from the Cloudflare dashboard. Required in
#                                cloudflare mode; the API refuses to boot
#                                without it rather than run unprotected.
#                                Never forwarded to the web or admin apps,
#                                never committed, never logged.
#   TURNSTILE_EXPECTED_HOSTNAMES (api, staging/prod) comma-separated hostnames
#                                the widget is served on. A token solved on
#                                any other hostname is refused. Required in
#                                cloudflare mode.
#   TURNSTILE_SITEVERIFY_TIMEOUT_MS
#                                (api, optional) how long siteverify may take
#                                before the request is refused as
#                                unavailable. Default 5000.
#   TURNSTILE_SITE_KEY           (web, staging/prod) the widget's PUBLIC site
#                                key — a different value from the secret, and
#                                the only Turnstile value the web reads. Read
#                                at request time, not baked in at build.
#                                Without it the forms say the check cannot
#                                run and do not submit.
#
# One widget per environment in the Cloudflare dashboard (staging,
# production, and optionally a `localhost` one for developers), each with its
# own hostname list and its own key pair, so a staging key can never verify a
# production token or the other way round. Cloudflare's published test keys
# are not a default anywhere in this code. The local stack needs none of the
# values below; to prove a real widget against localhost, set
# TURNSTILE_MODE=cloudflare with that widget's secret, hostname and site key
# in your untracked .env.
# TURNSTILE_MODE=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_EXPECTED_HOSTNAMES=
# TURNSTILE_SITEVERIFY_TIMEOUT_MS=
# TURNSTILE_SITE_KEY=

# ─── IP-scoped creation throttles ─────────────────────────────────────────────
#
# Both optional, positive whole numbers; anything else (unset, zero, non-numeric)
# falls back to the default. Both key on the caller's IP the same way the
# request-draft budget above does — Express `req.ip`, honouring
# X-Forwarded-For only when TRUST_PROXY is set.
#
#   AUTH_RATE_LIMIT_MAX               attempts allowed against the credential
#                                      endpoints (login/register) per window.
#                                      Default: 10.
#   AUTH_RATE_LIMIT_WINDOW_SECONDS    that window's length. Default: 60.
#   SERVICE_REQUEST_RATE_LIMIT_MAX    `POST /service-requests` calls allowed
#                                      per window. Default: 5.
#   SERVICE_REQUEST_RATE_LIMIT_WINDOW_SECONDS
#                                      that window's length. Default: 600 (10
#                                      minutes).
#
# Unlike the request-draft budget, both are deployment tuning values and are
# deliberately overridable: the end-to-end suite raises them (see
# e2e/playwright.config.ts) because every scenario there submits from
# 127.0.0.1 within minutes, and the shipped defaults have their own
# integration tests (auth-rate-limit.spec.ts,
# service-request-rate-limit.spec.ts) that are unaffected by this override.
#
# `POST /service-requests` also enforces two further, non-overridable limits
# per `customerPhone` inside the creation transaction — at most 5 requests in
# a rolling 24 hours and at most 10 open (APPROVED) at once — because those
# are a product rule about one phone number, not a per-deployment tuning
# value, and moving them would defeat the point of the limit.
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# SERVICE_REQUEST_RATE_LIMIT_MAX=5
# SERVICE_REQUEST_RATE_LIMIT_WINDOW_SECONDS=600

# Browser end-to-end suite (pnpm e2e).
#
# Leave E2E_DATABASE_URL unset to derive `<database>_e2e` from DATABASE_URL. The
# suite refuses to start against any database whose name does not end in _e2e,
# so it can never write to the development database or to the Vitest one.
#
# The application processes it starts listen on the ports below; they are well
# clear of the docker-compose stack (3000-3002) so both can run at once.
# E2E_DATABASE_URL=postgresql://taktic_user:taktic_password@localhost:5433/taktic_e2e?schema=public
E2E_WEB_PORT=3200
E2E_API_PORT=3201
E2E_ADMIN_PORT=3202
E2E_GATE_WEB_PORT=3210
E2E_GATE_API_PORT=3211
E2E_GATE_ADMIN_PORT=3212
E2E_CONTACT_WEB_PORT=3220
E2E_CONTACT_API_PORT=3221
E2E_CONTACT_ADMIN_PORT=3222
E2E_CLAIM_WEB_PORT=3230
E2E_CLAIM_API_PORT=3231
E2E_CLAIM_ADMIN_PORT=3232
E2E_PAYMENTS_WEB_PORT=3240
E2E_PAYMENTS_API_PORT=3241
E2E_PAYMENTS_ADMIN_PORT=3242
# The loopback stand-in for the Lemon Squeezy sandbox API. The payments runtime
# talks to it instead of the real one; the suite never contacts a payment
# provider.
E2E_LEMON_STUB_PORT=3299

# Test-only SMS and e-mail transports: when set, the API records what it would
# have sent to this directory instead of delivering it, so the end-to-end suite
# can read the one-time code it is supposed to type and follow the claim link it
# is supposed to receive. Set automatically by the Playwright config — never set
# it by hand, and never in production (the API refuses to boot with it set
# there). It is also not a delivering transport, so it cannot be used to satisfy
# PROVIDER_CLAIM_ENABLED in production. It must agree with EMAIL_TRANSPORT: with
# this set, the transport is `file-outbox` or the API refuses to boot.
# NOTIFICATION_OUTBOX_DIR=

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=taktic
POSTGRES_USER=taktic_user
POSTGRES_PASSWORD=taktic_password

DATABASE_URL=postgresql://taktic_user:taktic_password@localhost:5433/taktic?schema=public
