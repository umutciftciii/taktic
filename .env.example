NODE_ENV=development

API_PORT=3001
WEB_PORT=3000
ADMIN_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
AUTH_COOKIE_NAME=taktic_session
SESSION_TTL_DAYS=7
ADMIN_ORIGIN=http://localhost:3002
WEB_ORIGIN=http://localhost:3000

# Hides unverified requests from providers and blocks approving them.
# Keep false until a real SMS transport is configured: the console adapter only
# prints codes in development, so turning this on beforehand would strand every
# new request in an unverifiable state. Only "true"/"false" are accepted — any
# other value fails at boot rather than silently disabling the gate.
REQUIRE_PHONE_VERIFICATION=false

REFUND_SCHEDULER_ENABLED=false
REFUND_SCHEDULER_CRON=0 * * * *
REFUND_SCAN_OLDER_THAN_HOURS=48
REFUND_SCAN_LIMIT=100

# Closes APPROVED requests 14 days after their approval, and mails a single
# day-7 reminder to customers whose approved request still has no offer at all.
#
# Both default to false: they are the only writers that close a request or mail
# a customer with no human in the loop, so a half-configured environment must do
# nothing. Only "true"/"false" are accepted and the cron expressions are
# validated — a typo fails at boot rather than leaving a job silently off, or on
# a schedule nobody chose.
#
# Requests approved before the approvedAt column existed carry NULL and are
# never touched by either job, whatever these flags say.
REQUEST_EXPIRY_SCHEDULER_ENABLED=false
REQUEST_EXPIRY_SCHEDULER_CRON=15 * * * *
REQUEST_REMINDER_SCHEDULER_ENABLED=false
REQUEST_REMINDER_SCHEDULER_CRON=45 * * * *
# Requests one run of either job may touch (1–1000).
REQUEST_LIFECYCLE_SCAN_LIMIT=200

# Browser end-to-end suite (pnpm e2e).
#
# Leave E2E_DATABASE_URL unset to derive `<database>_e2e` from DATABASE_URL. The
# suite refuses to start against any database whose name does not end in _e2e,
# so it can never write to the development database or to the Vitest one.
#
# The six application processes it starts listen on the ports below; they are
# well clear of the docker-compose stack (3000-3002) so both can run at once.
# E2E_DATABASE_URL=postgresql://taktic_user:taktic_password@localhost:5433/taktic_e2e?schema=public
E2E_WEB_PORT=3200
E2E_API_PORT=3201
E2E_ADMIN_PORT=3202
E2E_GATE_WEB_PORT=3210
E2E_GATE_API_PORT=3211
E2E_GATE_ADMIN_PORT=3212

# Test-only SMS transport: when set, the API records what it would have sent to
# this directory instead of delivering it, so the end-to-end suite can read the
# one-time code it is supposed to type. Set automatically by the Playwright
# config — never set it by hand, and never in production (the API refuses to
# boot with it set there).
# NOTIFICATION_OUTBOX_DIR=

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=taktic
POSTGRES_USER=taktic_user
POSTGRES_PASSWORD=taktic_password

DATABASE_URL=postgresql://taktic_user:taktic_password@localhost:5433/taktic?schema=public
