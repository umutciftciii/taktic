    {
      "name": "repetition counts once",
      "text": "boya boya boya boya",
      "expected": 1
    },
    {
      "name": "digit runs are not words",
      "text": "123 4567 2024",
      "expected": 0
    },
    {
      "name": "no vowel is not a word",
      "text": "xyz zzz qwrt",
      "expected": 0
    },
    {
      "name": "residual: a three-letter mash with a vowel counts",
      "text": "asd qwe",
      "expected": 2
    },
    {
      "name": "filler and short words are dropped",
      "text": "lütfen merhaba acil çok ve bir",
      "expected": 0
    },
    {
      "name": "Turkish dotless I folds to one word",
      "text": "IŞIK ışık Işık",
      "expected": 1
    },
    {
      "name": "Turkish dotted İ folds to one word",
      "text": "İSTANBUL istanbul",
      "expected": 1
    },
    {
      "name": "an ordinary description",
      "text": "Salon kliması soğutmuyor; dış ünite ses yapıyor.",
      "expected": 7
    },
    {
      "name": "a token over twenty characters is dropped",
      "text": "aaaaaaaaaaaaaaaaaaaaaaaa kombi",
      "expected": 1
    },
    {
      "name": "numbers inside a description",
      "text": "3+1 daire, 2. kat",
      "expected": 2
    },
    {
      "name": "a unit with no vowel",
      "text": "Kombi 24kW",
      "expected": 1
    },
    {
      "name": "superscripts and dashes split words",
      "text": "Dış cephe boyası — 120 m² alan",
      "expected": 4
    },
    {
      "name": "NFC: a decomposed ü is the same word",
      "text": "ünite ünite",
      "expected": 1
    },
    {
      "name": "hyphenated words split",
      "text": "iç-dış",
      "expected": 1
    }
