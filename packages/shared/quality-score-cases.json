  "$comment": "QUALITY-SCORE-001 parity cases. Both calculators — apps/api/src/modules/service-requests/request-quality.ts and packages/shared/src/quality-score.ts — must produce exactly these results. Expected values are worked out by hand from packages/shared/quality-score.json; a component is null when it does not apply.",
  "words": [
    {
      "name": "empty",
      "text": "",
      "expected": 0
