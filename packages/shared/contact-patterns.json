{
  "digitRun": "\\d+",
  "groupedAmount": "\\d{1,3}(?:\\.\\d{3})+",
  "spaceGroupedAmount": "\\d{1,3}(?: \\d{3})+",
  "dateToken": "\\d{1,2}\\.\\d{1,2}\\.\\d{2,4}",
  "currencyBefore": "₺",
  "currencyAfter": "(?:₺|\\bTL\\b|\\blira)",
  "currencyWindow": 8,
  "phoneSeparators": "[\\s.\\-–—()]",
  "rangeDash": "[\\-–—]",
  "rangeDigitsMin": 4,
  "phoneDigitsMin": 10,
  "phoneDigitsMax": 13,
  "phoneRunSlackDigits": 3,
  "phonePrefixes": ["0", "90", "5"],
  "phoneShapes": [
    [11], [10],
    [4, 3, 2, 2], [4, 7], [4, 3, 4],
    [3, 3, 2, 2], [3, 7], [3, 3, 4],
    [1, 3, 3, 2, 2],
    [2, 3, 3, 2, 2], [2, 3, 7], [2, 3, 3, 4], [2, 10],
    [2, 4, 3, 2, 2], [2, 4, 7], [2, 11], [2, 1, 3, 3, 2, 2],
    [12], [5, 3, 2, 2], [5, 7]
  ],
  "strictPhone": "^(?:90(?:0)?[2-5]\\d{9}|0[2-5]\\d{9}|5\\d{9})$",
  "strictPhoneDashedPair": "^(?:90(?:0)?[2-5]\\d{9}|0[2-5]\\d{9})$",
  "email": "[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}",
  "emailObfuscated": "[^\\s]+\\s*[\\[(]\\s*at\\s*[\\])]\\s*[^\\s]+(\\s*[\\[(]\\s*(dot|nokta)\\s*[\\])]\\s*[^\\s]+)?",
  "url": "(https?://\\S+|\\bwww\\.\\S+|\\bwa\\.me/\\S*|\\bt\\.me/\\S*|\\b[a-z0-9-]+\\.(com|net|org|tr|io|me|co)\\b(/\\S*)?)"
}
