{
  "name": "taktic",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "e2e": "pnpm build && pnpm --filter @taktic/e2e e2e",
    "e2e:ui": "pnpm build && pnpm --filter @taktic/e2e e2e:ui",
    "e2e:install": "pnpm --filter @taktic/e2e e2e:install",
    "e2e:report": "pnpm --filter @taktic/e2e e2e:report",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.8.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  }
}
