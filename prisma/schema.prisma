generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CUSTOMER
  PROVIDER
}

enum CustomerOrigin {
  REGISTERED
  AUTO_CREATED_REQUEST
  ADMIN_CREATED
  IMPORTED
}

enum ServiceRequestQuestionType {
  TEXT
  TEXTAREA
  SELECT
  MULTI_SELECT
  NUMBER
  BOOLEAN
  DATE
  IMAGE
}

/// Lifecycle: DRAFT → SUBMITTED → IN_REVIEW → APPROVED → MATCHED → COMPLETED.
/// SUBMITTED and IN_REVIEW together are the moderation phase; they are kept
/// under their original names so existing rows, admin filters and tests stay
/// valid.
///
/// MATCHED is written only by the offer-accept cascade, EXPIRED only by the
/// (not yet built) expiry scheduler, COMPLETED and CANCELLED only by the
/// dedicated lifecycle endpoints — never by the admin moderation dropdown.
enum ServiceRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  MATCHED
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Why an offer ended up REJECTED. NULL means a customer rejected it by hand,
/// which is also the value every offer rejected before this field existed
/// carries — that keeps their refund behaviour unchanged.
enum OfferRejectionReason {
  /// The customer accepted a competing offer on the same request. These offers
  /// are deliberately NOT refundable: the provider's credit bought a real,
  /// delivered offer that simply was not selected.
  COMPETITOR_ACCEPTED
}

enum ProviderStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum OfferStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  CANCELLED
}

enum CreditTransactionType {
  ADMIN_GRANT
  ADMIN_DEDUCT
  PACKAGE_PURCHASE
  OFFER_SPEND
  OFFER_REFUND
  ADJUSTMENT
}

enum PackagePurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum NumberedEntityType {
  SERVICE_REQUEST
  OFFER
  PACKAGE_PURCHASE
}

model User {
  id             String          @id @default(cuid())
  email          String?         @unique
  phone          String?         @unique
  name           String?
  role           UserRole
  isActive       Boolean         @default(true)
  passwordHash   String?
  customerOrigin CustomerOrigin?
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  serviceRequests           ServiceRequest[]
  providerProfile           ProviderProfile?
  creditTransactions        ProviderCreditTransaction[]
  sessions                  Session[]
  customerNotes             CustomerNote[]              @relation("CustomerNoteCustomer")
  createdCustomerNotes      CustomerNote[]              @relation("CustomerNoteCreatedBy")
  activationTokens          CustomerActivationToken[]   @relation("CustomerActivationTokenCustomer")
  createdActivationTokens   CustomerActivationToken[]   @relation("CustomerActivationTokenCreatedBy")
  adminInviteTokens         AdminInviteToken[]          @relation("AdminInviteTokenUser")
  createdAdminInviteTokens  AdminInviteToken[]          @relation("AdminInviteTokenCreatedBy")
  notificationLogs          NotificationLog[]

  @@index([role])
  @@index([isActive])
}

model Session {
  id         String    @id
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model ServiceCategory {
  id            String   @id @default(cuid())
  parentId      String?
  name          String
  slug          String   @unique
  description   String?
  /// Credits a provider spends to submit one offer on a request in this
  /// category. There is deliberately NO default: a default value would be the
  /// hidden "1 credit" fallback the pricing rules forbid.
  ///
  /// NULL means "price not set yet" — a first-class, observable state that is
  /// distinct from 0, and it blocks offering entirely. A database CHECK
  /// constraint (see the migration) makes 0 and negatives unrepresentable.
  ///
  /// There is no hierarchical inheritance: a request uses the cost of exactly
  /// the category it is attached to, never a parent's.
  offerCreditCost Int?
  imageUrl      String?
  coverImageUrl String?
  iconKey       String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent    ServiceCategory?          @relation("ServiceCategoryTree", fields: [parentId], references: [id])
  children  ServiceCategory[]         @relation("ServiceCategoryTree")
  questions ServiceRequestQuestion[]
  requests  ServiceRequest[]
  providers ProviderServiceCategory[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model ServiceRequestQuestion {
  id         String                     @id @default(cuid())
  categoryId String
  key        String
  label      String
  helpText   String?
  type       ServiceRequestQuestionType
  isRequired Boolean                    @default(false)
  options    Json?
  sortOrder  Int                        @default(0)
  isActive   Boolean                    @default(true)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  category ServiceCategory        @relation(fields: [categoryId], references: [id])
  answers  ServiceRequestAnswer[]

  @@unique([categoryId, key])
  @@index([categoryId, isActive, sortOrder])
}

model ServiceRequest {
  id                    String               @id @default(cuid())
  requestNumber         String?              @unique
  categoryId            String
  customerId            String?
  status                ServiceRequestStatus @default(SUBMITTED)
  customerName          String
  customerPhone         String
  customerEmail         String?
  city                  String
  district              String
  neighborhood          String?
  addressNote           String?
  budgetMin             Int?
  budgetMax             Int?
  preferredDate         DateTime?
  urgency               String?
  description           String?
  qualityScore          Int                  @default(0)
  qualityScoreBreakdown Json?
  moderatedAt           DateTime?
  moderationNote        String?
  rejectionReason       String?
  /// When the customer proved control of customerPhone via a one-time code.
  /// NULL means "not verified" — including every request created before phone
  /// verification existed. What that blocks depends on REQUIRE_PHONE_VERIFICATION.
  phoneVerifiedAt       DateTime?
  /// The single accepted offer. Unique so the request can never point at two
  /// winners; the accept cascade is what writes it.
  matchedOfferId        String?              @unique
  matchedAt             DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  expiredAt             DateTime?
  submittedAt           DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  category     ServiceCategory        @relation(fields: [categoryId], references: [id])
  customer     User?                  @relation(fields: [customerId], references: [id])
  answers      ServiceRequestAnswer[]
  offers       Offer[]
  matchedOffer Offer?                 @relation("ServiceRequestMatchedOffer", fields: [matchedOfferId], references: [id])
  phoneVerifications PhoneVerification[]
  notificationLogs   NotificationLog[]

  @@index([categoryId])
  @@index([customerId])
  @@index([status])
  @@index([city, district])
  @@index([submittedAt])
  @@index([status, submittedAt])
  @@index([phoneVerifiedAt])
}

/// A one-time code proving control of a phone number.
///
/// The code itself is never stored: only a bcrypt hash of it, so a database
/// dump cannot be replayed. There is deliberately NO unique constraint on
/// codeHash — six digits collide often, and a unique index would leak that a
/// code is already in flight elsewhere.
model PhoneVerification {
  id              String    @id @default(cuid())
  /// Digits-and-plus normalisation of the request's customerPhone.
  normalizedPhone String
  codeHash        String
  expiresAt       DateTime
  consumedAt      DateTime?
  /// Wrong codes entered against this row. At the limit the row locks.
  attemptCount    Int       @default(0)
  lockedUntil     DateTime?
  /// How many codes have been issued in this request/phone conversation.
  resendCount     Int       @default(0)
  lastSentAt      DateTime  @default(now())
  requestId       String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// Per-phone send budget and "find the active code" lookups.
  @@index([normalizedPhone, createdAt])
  /// Per-IP send budget.
  @@index([ipAddress, createdAt])
  @@index([requestId])
  /// Cleanup of expired rows.
  @@index([expiresAt])
}

/// Audit trail of outbound messages.
///
/// Deliberately stores nothing that could be replayed or that identifies the
/// recipient beyond a mask: no code, no token, no action URL, no message body,
/// no raw phone or e-mail address.
model NotificationLog {
  id                String              @id @default(cuid())
  channel           NotificationChannel
  template          String
  /// e.g. "u***@example.com" or "+90 *** *** ** 34".
  maskedRecipient   String
  status            NotificationStatus  @default(PENDING)
  providerMessageId String?
  /// Safe, enumerable failure class — never a raw provider error string.
  errorCode         String?
  requestId         String?
  userId            String?
  createdAt         DateTime            @default(now())
  sentAt            DateTime?
  failedAt          DateTime?

  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([channel, createdAt])
  @@index([status, createdAt])
  @@index([template, createdAt])
  @@index([requestId])
  @@index([userId])
}

model ServiceRequestAnswer {
  id            String   @id @default(cuid())
  requestId     String
  questionId    String
  questionKey   String
  questionLabel String
  questionType  String
  value         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  request  ServiceRequest         @relation(fields: [requestId], references: [id])
  question ServiceRequestQuestion @relation(fields: [questionId], references: [id])

  @@unique([requestId, questionId])
  @@index([questionId])
}

model ProviderProfile {
  id              String         @id @default(cuid())
  // A platform account may own at most one provider profile. The column stays
  // nullable so guest (unclaimed) applications remain possible: PostgreSQL
  // treats NULLs as distinct in a unique index, so the constraint only binds
  // rows where userId IS NOT NULL.
  userId          String?        @unique
  businessName    String
  contactName     String
  phone           String
  email           String?
  taxType         String?
  taxNumber       String?
  city            String
  district        String
  addressNote     String?
  description     String?
  status          ProviderStatus @default(PENDING_REVIEW)
  moderationNote  String?
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user               User?                       @relation(fields: [userId], references: [id])
  serviceCategories  ProviderServiceCategory[]
  serviceAreas       ProviderServiceArea[]
  offers             Offer[]
  creditTransactions ProviderCreditTransaction[]
  packagePurchases   PackagePurchase[]

  @@index([status])
  @@index([city])
  @@index([district])
  @@index([phone])
  @@index([email])
}

model ProviderServiceCategory {
  id         String   @id @default(cuid())
  providerId String
  categoryId String
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  @@unique([providerId, categoryId])
  @@index([categoryId])
}

model ProviderServiceArea {
  id           String   @id @default(cuid())
  providerId   String
  city         String
  district     String?
  neighborhood String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id])

  @@unique([providerId, city, district, neighborhood])
  @@index([city])
  @@index([district])
}

model Offer {
  id                          String      @id @default(cuid())
  offerNumber                 String?     @unique
  requestId                   String
  providerId                  String
  status                      OfferStatus @default(SUBMITTED)
  priceAmount                 Int
  currency                    String      @default("TRY")
  estimatedStartDate          DateTime?
  estimatedCompletionDate     DateTime?
  message                     String
  warrantyNote                String?
  internalNote                String?
  creditCost                  Int         @default(1)
  creditSpentTransactionId    String?
  creditRefundedTransactionId String?
  creditRefundedAt            DateTime?
  creditRefundReason          String?
  submittedAt                 DateTime    @default(now())
  viewedAt                    DateTime?
  acceptedAt                  DateTime?
  rejectedAt                  DateTime?
  rejectionReason             OfferRejectionReason?
  withdrawnAt                 DateTime?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  request       ServiceRequest  @relation(fields: [requestId], references: [id])
  provider      ProviderProfile @relation(fields: [providerId], references: [id])
  matchedForRequest ServiceRequest? @relation("ServiceRequestMatchedOffer")

  @@unique([providerId, requestId])
  @@index([requestId])
  @@index([providerId])
  @@index([status])
  @@index([submittedAt])
  @@index([creditSpentTransactionId])
  @@index([creditRefundedTransactionId])
  @@index([rejectionReason])
  // A PostgreSQL partial unique index — "Offer_one_accepted_per_request",
  // UNIQUE ("requestId") WHERE status = 'ACCEPTED' — is created by the
  // add_request_matching migration. Prisma cannot express partial indexes in
  // this schema, so it lives in raw SQL; it is the database-level backstop that
  // makes a second accepted offer on a request unrepresentable even if the
  // application guard is bypassed.
}

model OfferCreditPackage {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  creditAmount Int
  priceAmount  Int
  currency     String   @default("TRY")
  description  String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases PackagePurchase[]

  @@index([isActive, sortOrder])
}

model PackagePurchase {
  id                       String                @id @default(cuid())
  purchaseNumber           String?               @unique
  providerId               String
  packageId                String
  status                   PackagePurchaseStatus @default(PENDING)
  creditAmountSnapshot     Int
  priceAmountSnapshot      Int
  currencySnapshot         String                @default("TRY")
  packageNameSnapshot      String
  providerNote             String?
  adminNote                String?
  mockPaymentReference     String?
  mockPaymentFailureReason String?
  paidAt                   DateTime?
  failedAt                 DateTime?
  cancelledAt              DateTime?
  expiredAt                DateTime?
  refundedAt               DateTime?
  creditTransactionId      String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  provider ProviderProfile    @relation(fields: [providerId], references: [id])
  package  OfferCreditPackage @relation(fields: [packageId], references: [id])

  @@index([providerId])
  @@index([packageId])
  @@index([status])
  @@index([createdAt])
  @@index([mockPaymentReference])
}

model SequenceCounter {
  id         String             @id @default(cuid())
  entityType NumberedEntityType
  year       Int
  lastNumber Int                @default(0)
  updatedAt  DateTime           @updatedAt

  @@unique([entityType, year])
  @@index([entityType])
}

model ProviderCreditTransaction {
  id            String                @id @default(cuid())
  providerId    String
  type          CreditTransactionType
  amount        Int
  balanceAfter  Int
  reason        String?
  referenceType String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime              @default(now())

  provider  ProviderProfile @relation(fields: [providerId], references: [id])
  createdBy User?           @relation(fields: [createdById], references: [id])

  @@index([providerId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model CustomerNote {
  id          String   @id @default(cuid())
  customerId  String
  note        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  User  @relation("CustomerNoteCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CustomerNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([createdById])
  @@index([createdAt])
}

model CustomerActivationToken {
  id          String    @id @default(cuid())
  customerId  String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  customer  User  @relation("CustomerActivationTokenCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CustomerActivationTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([createdById])
  @@index([expiresAt])
}

model AdminInviteToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  user      User  @relation("AdminInviteTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AdminInviteTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdById])
  @@index([expiresAt])
}
