generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CUSTOMER
  PROVIDER
}

enum CustomerOrigin {
  REGISTERED
  AUTO_CREATED_REQUEST
  ADMIN_CREATED
  IMPORTED
}

/// What a category *is* in the tree, as opposed to whether it is visible.
///
/// GROUP is navigation only: it holds children, never questions, never requests
/// and never a provider. LEAF is the only kind a request, an offer, a credit
/// charge or a provider's service list may point at. ROUTER is an entry point
/// that owns exactly one question whose options each name the LEAF (or further
/// ROUTER) the customer really meant.
///
/// LEAF is the default so every category that existed before this enum — all of
/// which take requests — keeps behaving exactly as it did.
enum ServiceCategoryKind {
  GROUP
  LEAF
  ROUTER
}

/// Operational readiness, kept apart from public visibility on purpose.
///
/// DRAFT   — visible in admin, invisible to the public and to provider
///           discovery. An admin may open a request against it to smoke-test
///           the form; nobody else may.
/// ACTIVE  — public, matchable, open for new requests.
/// INACTIVE— closed for new requests and for new provider selections, for
///           everyone including admins. Existing requests, offers and answers
///           stay readable; nothing about the past is rewritten.
///
/// The legacy `isActive` boolean is kept and mirrored (ACTIVE ⇔ true) so every
/// response body and every query written before this enum keeps working.
enum ServiceCategoryStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// How a conditional question reads a multi-answer source.
///
/// ANY — the default, and the only behaviour that existed before this enum —
/// means "the customer ticked at least one of these". ALL means "the customer
/// ticked all of these". They differ only for a MULTI_SELECT source, which is
/// why ALL is refused on any other kind: on a single-choice question the two
/// would be the same rule wearing two names, and an admin choosing between them
/// would be choosing nothing.
enum QuestionConditionMatchMode {
  ANY
  ALL
}

/// The request column a question is bound to, instead of an answer row.
///
/// A bound question is a *label and a requirement* placed on a field the
/// request already has — it is never stored a second time in
/// ServiceRequestAnswer, and the API refuses an answer sent for one. That is
/// the whole point: the address a customer types must stay the address provider
/// matching reads, not a copy of it that can drift.
///
/// NULL — the default and what every question written before this column
/// carries — means an ordinary question answered into ServiceRequestAnswer.
enum ServiceRequestQuestionSystemField {
  /// ServiceRequest.city / district / neighborhood
  ADDRESS
  /// ServiceRequest.budgetMin / budgetMax
  BUDGET
  /// ServiceRequest.description
  DESCRIPTION
  /// ServiceRequest.preferredDate
  PREFERRED_DATE
}

enum ServiceRequestQuestionType {
  TEXT
  TEXTAREA
  SELECT
  MULTI_SELECT
  NUMBER
  BOOLEAN
  DATE
  IMAGE
}

/// Lifecycle: DRAFT → SUBMITTED → IN_REVIEW → APPROVED → MATCHED → COMPLETED.
/// SUBMITTED and IN_REVIEW together are the moderation phase; they are kept
/// under their original names so existing rows, admin filters and tests stay
/// valid.
///
/// MATCHED is written only by the offer-accept cascade, EXPIRED only by the
/// (not yet built) expiry scheduler, COMPLETED and CANCELLED only by the
/// dedicated lifecycle endpoints — never by the admin moderation dropdown.
enum ServiceRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  MATCHED
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Why an offer ended up REJECTED. NULL means a customer rejected it by hand,
/// which is also the value every offer rejected before this field existed
/// carries — that keeps their refund behaviour unchanged.
enum OfferRejectionReason {
  /// The customer accepted a competing offer on the same request. These offers
  /// are deliberately NOT refundable: the provider's credit bought a real,
  /// delivered offer that simply was not selected.
  COMPETITOR_ACCEPTED
}

/// Why an offer can never be refunded by the automatic 48-hour rule again.
///
/// Separate from `viewedAt` on purpose. Both facts close refund eligibility,
/// but they are different events and conflating them would be a lie in the
/// database: writing a `viewedAt` the customer never earned would tell the
/// provider's panel, the admin timeline and every future reader that a customer
/// opened an offer nobody opened.
enum OfferRefundBlockReason {
  /// An administrator accepted or rejected the offer on the customer's behalf.
  /// The outcome the offer was bought for was delivered — a decision was made
  /// and recorded — so the credit is spent, even though the customer never
  /// opened the offer themselves.
  ADMIN_CUSTOMER_DECISION
}

enum ProviderStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

/// How wide one `ProviderServiceArea` row reaches.
///
/// The column is redundant with the nullability of `district` and
/// `neighborhood` — and that is the point. PostgreSQL treats NULLs as distinct
/// in a unique index, so "one row per province" cannot be expressed over a
/// nullable district at all; it can be expressed over a scope that is never
/// NULL. The three partial unique indexes documented on the model key on this
/// column, and a CHECK constraint keeps it from ever disagreeing with the
/// levels it names.
///
/// It is written by the API only, from the levels the applicant chose — see
/// `serviceAreaScopeOf` — never accepted from a request body.
enum ProviderServiceAreaScope {
  /// City named, district and neighbourhood NULL: every request in the province.
  CITY
  /// City and district named, neighbourhood NULL: every request in the district.
  DISTRICT
  /// All three named: only requests at that neighbourhood.
  NEIGHBORHOOD
}

enum OfferStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  CANCELLED
}

enum CreditTransactionType {
  ADMIN_GRANT
  ADMIN_DEDUCT
  PACKAGE_PURCHASE
  OFFER_SPEND
  OFFER_REFUND
  ADJUSTMENT
}

enum PackagePurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

/**
 * What a verified payment-provider webhook event was allowed to do.
 * The row exists for every event that got past signature verification,
 * including the ones that changed nothing: "this arrived and was refused" is
 * the only thing an operator can act on later, and it must not depend on a log
 * line surviving. No payload, no signature and no customer detail is ever
 * stored alongside it — see PaymentWebhookEvent.
 */
enum PaymentWebhookEventStatus {
  PROCESSED
  DUPLICATE
  IGNORED
  MISMATCHED
  MANUAL_REVIEW_REQUIRED
}

enum NumberedEntityType {
  SERVICE_REQUEST
  OFFER
  PACKAGE_PURCHASE
}

/// Which side of a matched pair wrote a message.
///
/// Stored on the row rather than derived from the sender's current UserRole:
/// the role on the account can change, and a two-year-old message must still
/// read as having come from the customer or from the provider it came from.
enum MessageSenderRole {
  CUSTOMER
  PROVIDER
}

/// Where a support ticket is in its one-way life.
///
/// OPEN is a ticket nobody has picked up; IN_PROGRESS is one an operator is
/// working; RESOLVED is one the operator believes is answered; CLOSED is the
/// end. The order is deliberate and the transitions are enumerated in
/// `support-ticket.rules.ts`: OPEN and IN_PROGRESS swap freely, either may be
/// resolved, only a RESOLVED ticket may be closed, and CLOSED is terminal.
/// A customer who needs more help after that opens a new ticket, which keeps
/// the record of what was already answered intact.
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Which side of the desk a ticket message came from.
///
/// Stored on the row rather than derived from the author's current UserRole,
/// for the same reason MessageSenderRole is: a role can change on an account,
/// and an old message must still read as having come from the side it came
/// from.
///
/// PROVIDER was added when the desk opened to the other side of the
/// marketplace. It is a third value rather than a reuse of CUSTOMER because a
/// message is a permanent record of who said something: every row written
/// before that change really was written by a customer, and widening the
/// meaning of CUSTOMER would have rewritten all of them at once.
enum SupportTicketAuthorRole {
  CUSTOMER
  ADMIN
  PROVIDER
}

/// Which side of the marketplace opened a ticket.
///
/// A snapshot, exactly like SupportTicketAuthorRole above and for the same
/// reason: authorization, the admin queue's filter and every notification read
/// this column rather than the owner's current `User.role`, so an account whose
/// role is changed later cannot make an old ticket read as the other side's —
/// or, worse, make it reachable from the other side's routes.
///
/// There is deliberately no SUPER_ADMIN member. An operator answers tickets and
/// owns none, there is no create route on the admin controller, and a value
/// nothing can write is a state a reader would still have to handle.
enum SupportTicketRequesterRole {
  CUSTOMER
  PROVIDER
}

model User {
  id              String          @id @default(cuid())
  /// The account's address, and the platform's answer to "which kind of account
  /// is this person".
  ///
  /// Unique, and stored only in its normalised form — trimmed and lower-cased —
  /// which a CHECK constraint enforces (`User_email_normalized_check`, added by
  /// the migration of the same name). The two facts are one rule together: an
  /// account carries exactly one role, so a unique index over a single stored
  /// form is what makes it impossible for one address to hold both a customer
  /// account and a provider account. The index alone was not enough, because a
  /// byte-exact index keeps `Ayse@…` and `ayse@…` apart and the folding lived in
  /// application code that any new caller could forget.
  ///
  /// Nullable, and several rows use that: an account may exist without an
  /// address, and PostgreSQL treats NULLs as distinct in a unique index.
  email           String?         @unique
  phone           String?         @unique
  name            String?
  role            UserRole
  isActive        Boolean         @default(true)
  passwordHash    String?
  /// When this account proved control of `email` by following a verification
  /// link, and never for any other reason.
  ///
  /// NULL means "no proof on file" — which is what every account created before
  /// this column existed carries, deliberately: nobody ever showed them a link,
  /// so backfilling would record a proof that never happened. Setting a
  /// password through the activation link counts, because that link is itself
  /// delivered to the mailbox and consumed once.
  ///
  /// Nothing is gated on it today. It records a fact; it does not (yet) grant
  /// or withhold anything.
  emailVerifiedAt DateTime?
  /// The province the account keeps on file, in the canonical spelling
  /// `turkey-locations.ts` publishes — the same vocabulary a service request
  /// and a provider service area are stored in, so the three can be compared
  /// without folding anything at read time.
  ///
  /// Nullable, and deliberately so: it is a convenience the customer may set
  /// and may clear again, and no flow requires it. A request still names its
  /// own city and district, because the job happens where the job happens and
  /// not where the customer's account says they live.
  city            String?
  customerOrigin  CustomerOrigin?
  lastLoginAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  serviceRequests               ServiceRequest[]
  providerProfile               ProviderProfile?
  creditTransactions            ProviderCreditTransaction[]
  sessions                      Session[]
  customerNotes                 CustomerNote[]                     @relation("CustomerNoteCustomer")
  createdCustomerNotes          CustomerNote[]                     @relation("CustomerNoteCreatedBy")
  activationTokens              CustomerActivationToken[]          @relation("CustomerActivationTokenCustomer")
  createdActivationTokens       CustomerActivationToken[]          @relation("CustomerActivationTokenCreatedBy")
  adminInviteTokens             AdminInviteToken[]                 @relation("AdminInviteTokenUser")
  passwordResetTokens           PasswordResetToken[]
  emailVerificationTokens       EmailVerificationToken[]
  createdAdminInviteTokens      AdminInviteToken[]                 @relation("AdminInviteTokenCreatedBy")
  notificationLogs              NotificationLog[]
  contactRevealEvents           ContactRevealEvent[]
  createdProviderClaimTokens    ProviderClaimToken[]               @relation("ProviderClaimTokenCreatedBy")
  createdProviderInvites        ProviderInviteToken[]              @relation("ProviderInviteTokenCreatedBy")
  companySettingsUpdates        CompanySettings[]                  @relation("CompanySettingsUpdatedBy")
  operationsSettingsUpdates     OperationsSettings[]               @relation("OperationsSettingsUpdatedBy")
  operationsSettingsChanges     OperationsSettingsChange[]         @relation("OperationsSettingsChangedBy")
  customerMessageThreads        MessageThread[]                    @relation("MessageThreadCustomer")
  manualOfferRefunds            ManualOfferRefundAudit[]           @relation("ManualOfferRefundPerformedBy")
  providerMessageThreads        MessageThread[]                    @relation("MessageThreadProviderUser")
  sentMessages                  Message[]                          @relation("MessageSender")
  supportTickets                SupportTicket[]                    @relation("SupportTicketRequester")
  supportTicketMessages         SupportTicketMessage[]             @relation("SupportTicketMessageAuthor")
  supportTicketStatusChanges    SupportTicketStatusChange[]        @relation("SupportTicketStatusChangedBy")
  showcaseCardReviews           ShowcaseCardReview[]               @relation("ShowcaseCardReviewedBy")
  showcasePlacementSuspensions  ShowcasePlacementSuspension[]      @relation("ShowcasePlacementSuspendedBy")
  showcasePriceTermsAcceptances ShowcaseCardPriceTermsAcceptance[]
  showcasePackageTermsAcceptances ShowcasePackageTermsAcceptance[] @relation("ShowcasePackageTermsAcceptedBy")

  @@index([role])
  @@index([isActive])
}

/// The company behind the platform, as an operator maintains it.
///
/// The legal name, the support address and the postal address are business
/// facts, not deployment configuration: they change when the company changes,
/// they are the operator's to correct, and nobody should need a redeploy — or a
/// shell on the API host — to fix a typo in the footer every customer reads.
/// They used to live in the environment, which is why a real message once went
/// out telling a customer to write to a placeholder address.
///
/// What stays in the environment is the technical half: which transport is
/// bound, its credentials, the verified sender address, and the public URL every
/// link is built from. Those are facts about the deployment, they are secrets or
/// close to it, and an admin screen has no business editing them.
///
/// Exactly one row, forever. `id` defaults to the literal "singleton" and a
/// CHECK constraint refuses any other value, so "the settings" is a database
/// guarantee rather than a convention the service is trusted to keep. Nothing is
/// seeded: the row does not exist until an operator saves one, and until then
/// the admin screen says so and a delivering transport refuses to compose a
/// footer it cannot fill.
model CompanySettings {
  id            String   @id @default("singleton")
  /// The sender's legal name, as it appears in the footer. Free text: a legal
  /// entity is not the product name, and this platform cannot guess it.
  legalName     String
  /// Where a customer's reply is actually read. Deliberately unrelated to
  /// EMAIL_FROM, which is a no-reply mailbox on the verified sending domain.
  ///
  /// Saving it is not proof that anybody controls it — there is no ownership
  /// challenge here, and inventing one would be a product decision of its own.
  /// What is enforced is that the value is a well-formed address and not the
  /// development placeholder.
  supportEmail  String
  /// Optional, and it stays optional. A wrong postal address is worse than an
  /// absent one, so the footer drops the line rather than inventing a street.
  postalAddress String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Who last saved this, for the same reason every other admin-written row in
  /// this schema records it. Nullable and SetNull: an operator's account may be
  /// removed long after they corrected the footer.
  updatedById   String?

  updatedBy User? @relation("CompanySettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

/// The operations settings a super admin maintains, as one row.
///
/// Today it holds one value — how long a customer has to open an offer before
/// the provider's credit comes back. That is a commercial term rather than a
/// deployment fact: it is the promise printed on the provider's own screens, it
/// changes when the business decides it changes, and nobody should need a
/// redeploy to change it.
///
/// Exactly one row, forever, by the same construction CompanySettings uses: the
/// id defaults to "singleton" and a CHECK constraint refuses every other value.
///
/// Nothing is seeded, and the absence of a row is not a gap. An unsaved setting
/// reads as the product default (48 hours), which is the term every offer in the
/// database was already created under — so the platform behaves identically
/// before and after an operator first opens this screen.
///
/// Changing this row never reaches an offer that already exists. Each offer
/// snapshots its own window and its own eligibility moment when it is created
/// (see `Offer.unviewedRefundEligibleAt`), and the worker reads that snapshot;
/// this row only decides what the *next* offer is sold under.
model OperationsSettings {
  id                                      String   @id @default("singleton")
  /// How many whole hours a customer has to open an offer before its credit is
  /// automatically refunded. Whole hours only — the value is written verbatim
  /// into provider-facing sentences ("... 48 saat içinde ..."), and a fractional
  /// window has no sentence.
  unviewedOfferRefundWindowHours          Int
  /// Whether each background job may act, as four independent switches.
  ///
  /// These replace the environment flags the four schedulers used to read. A
  /// job's cron *expression* is still deployment configuration — when it wakes
  /// up is an infrastructure decision — but whether it does anything when it
  /// wakes up is an operations decision, and it belongs where the other
  /// operations decisions are, with OperationsSettingsChange behind it.
  ///
  /// False by default, and read fail-closed: no row, an unreadable row or a
  /// false column all mean the job does nothing. Every tick re-reads these, so
  /// a super admin's toggle takes effect on the next natural tick without a
  /// restart, and no process holds a cached "on" the panel disagrees with.
  entitlementRenewalSchedulerEnabled      Boolean  @default(false)
  unviewedOfferRefundSchedulerEnabled     Boolean  @default(false)
  requestExpirySchedulerEnabled           Boolean  @default(false)
  requestReminderSchedulerEnabled         Boolean  @default(false)
  /// The two vitrin jobs, added under exactly the same contract as the four
  /// above: false by default, read fail-closed on every tick, and switched on
  /// by a person on a screen — never by a migration and never by an
  /// environment variable.
  showcaseLeadSlaSchedulerEnabled         Boolean  @default(false)
  showcasePlacementExpirySchedulerEnabled Boolean  @default(false)
  createdAt                               DateTime @default(now())
  updatedAt                               DateTime @updatedAt
  /// Who last saved this. Nullable and SetNull for the same reason
  /// CompanySettings uses: an operator's account may be removed long after they
  /// changed a term. The permanent record of *what* changed is
  /// OperationsSettingsChange, which does not lose its operator.
  updatedById                             String?

  updatedBy User? @relation("OperationsSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

/// One recorded change to an operations setting: the old value, the new value,
/// the administrator and the moment.
///
/// A separate table rather than an `updatedAt` on the row above, because the row
/// above only ever shows the current answer. A commercial term that decides
/// refunds has to be answerable after the fact — "what was the window on the
/// third, and who set it?" — and a settings row that overwrites itself cannot
/// answer that.
///
/// `previousValue` is NULL exactly once per setting: the first save, when the
/// effective value was the product default rather than something an operator
/// chose. Written in the same transaction as the setting itself, so a change
/// with nobody's name on it cannot exist.
model OperationsSettingsChange {
  id            String   @id @default(cuid())
  /// Which setting changed, as the field name on OperationsSettings. A column
  /// rather than one table per setting, so a second operations setting needs no
  /// second audit table.
  setting       String
  /// Both values as text: the audit trail keeps its shape when a future setting
  /// is not an integer, and a stored number nobody can compare against its own
  /// column type is worth less than the string that was actually saved.
  previousValue String?
  newValue      String
  changedById   String
  createdAt     DateTime @default(now())

  changedBy User @relation("OperationsSettingsChangedBy", fields: [changedById], references: [id])

  @@index([setting, createdAt])
  @@index([changedById])
}

/// One signed-in session, and the two independent clocks that end it.
///
/// `expiresAt` is the **absolute** lifetime, fixed when the session is created
/// and never moved forward. `lastSeenAt` is the **idle** clock: a session whose
/// last activity is older than the inactivity window is refused, however much
/// absolute time it has left. Activity slides the idle window and nothing else
/// — it never buys absolute time — so there is no sliding session, and both
/// clocks are checked on the server against the database, so a browser clock
/// has no say in whether a session is still valid.
///
/// Both windows come from `rememberMe` below. The shipped defaults are 30
/// minutes idle and 8 hours absolute for an ordinary session, and 30 days idle
/// and 30 days absolute for a remembered one; `auth.constants.ts` is where they
/// live and where an operator can change them.
///
/// `lastSeenAt` is touched at most once per touch interval rather than on every
/// request, so an active user does not turn one row into a write hot spot.
model Session {
  id         String    @id
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  /// Whether the person ticked "Beni hatırla" when this session was issued.
  ///
  /// It selects a whole policy, not a longer cookie: this session's own idle
  /// window *and* its own absolute lifetime, both enforced on the server from
  /// this column. A remembered session is given 30 days of each; an ordinary
  /// one 30 minutes of idle and 8 hours absolute. Only the durations differ —
  /// the shape is the same either way, and activity still slides only the idle
  /// clock.
  ///
  /// The one client-side thing it also decides is whether the cookie is
  /// persistent or dies with the browser.
  ///
  /// `false` for every session issued before this column existed, which is what
  /// those sessions actually were.
  rememberMe Boolean   @default(false)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  /// The idle sweep and the "is this session still alive" read both key on it.
  @@index([lastSeenAt])
}

model ServiceCategory {
  id                       String                @id @default(cuid())
  parentId                 String?
  name                     String
  slug                     String                @unique
  description              String?
  /// Credits a provider spends to submit one offer on a request in this
  /// category. There is deliberately NO default: a default value would be the
  /// hidden "1 credit" fallback the pricing rules forbid.
  ///
  /// NULL means "price not set yet" — a first-class, observable state that is
  /// distinct from 0, and it blocks offering entirely. A database CHECK
  /// constraint (see the migration) makes 0 and negatives unrepresentable.
  ///
  /// There is no hierarchical inheritance: a request uses the cost of exactly
  /// the category it is attached to, never a parent's.
  offerCreditCost          Int?
  imageUrl                 String?
  coverImageUrl            String?
  iconKey                  String?
  /// What this category is in the tree. See ServiceCategoryKind.
  kind                     ServiceCategoryKind   @default(LEAF)
  /// Operational readiness. See ServiceCategoryStatus.
  ///
  /// `isActive` below is the same fact in the shape every existing caller and
  /// response body already speaks, and the two are written together by
  /// CategoriesService — never one without the other.
  status                   ServiceCategoryStatus @default(ACTIVE)
  /// Whether a provider may put this category in their own service list.
  ///
  /// Only ever consulted for a DRAFT leaf. An ACTIVE leaf is always open — see
  /// isProviderEnrollmentOpen — because closing a live category to provider
  /// selection would refuse every profile save against it, and that is one
  /// misclick away from an outage nobody would attribute to a checkbox.
  ///
  /// Defaults to false so a category never starts recruiting by accident: a
  /// newly created or newly imported draft is invisible to applicants until an
  /// operator opens it. The migration backfills ACTIVE leaves to true, which is
  /// what keeps enrollment open if one of them is later pulled back to DRAFT.
  providerEnrollmentOpen   Boolean               @default(false)
  /// Whether this category may be put inside a CATEGORY_UNLIMITED package's
  /// scope.
  ///
  /// Defaults to false for every category that exists and every category that
  /// will ever be created, including the ones the taxonomy import brings in.
  /// That is the rule "regulated or high-value categories are not part of an
  /// unlimited package by default" implemented the only way that cannot be
  /// forgotten: nothing is eligible until an admin opts it in, so a category
  /// nobody has considered is a category nobody can sell unmetered offering on.
  ///
  /// Being eligible is necessary and never sufficient. A package's scope is
  /// checked against this flag at write time, and offering is still refused for
  /// an INACTIVE category, a category the provider is not bound to, and every
  /// other rule that applied before packages existed.
  unlimitedPackageEligible Boolean               @default(false)
  isActive                 Boolean               @default(true)
  sortOrder                Int                   @default(0)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  /// Restrict, not the implicit SetNull: silently orphaning a subtree is how a
  /// category tree loses a whole branch without anybody being told. A parent
  /// with children cannot be deleted — the API says so with a 409, and the
  /// database says so even if something bypasses the API.
  parent             ServiceCategory?                  @relation("ServiceCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           ServiceCategory[]                 @relation("ServiceCategoryTree")
  questions          ServiceRequestQuestion[]
  requests           ServiceRequest[]
  entryRequests      ServiceRequest[]                  @relation("ServiceRequestEntryCategory")
  providers          ProviderServiceCategory[]
  routerRulesIn      ServiceCategoryRouterRule[]       @relation("ServiceCategoryRouterTarget")
  providerInvites    ProviderInviteToken[]
  packageScopes      OfferPackageScopeCategory[]
  entitlementScopes  ProviderPackageEntitlementScope[]
  showcaseCards      ShowcaseCard[]
  showcasePlacements ShowcasePlacement[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  /// The public listing: "ACTIVE leaves, in order".
  @@index([status, kind, sortOrder])
}

model ServiceRequestQuestion {
  id          String                             @id @default(cuid())
  categoryId  String
  key         String
  label       String
  helpText    String?
  type        ServiceRequestQuestionType
  isRequired  Boolean                            @default(false)
  options     Json?
  /// When set, this question does not produce an answer row: it labels and
  /// constrains the request column named by the enum. See
  /// ServiceRequestQuestionSystemField.
  systemField ServiceRequestQuestionSystemField?
  /// Whether this is the routing question of a ROUTER category — the one whose
  /// options carry ServiceCategoryRouterRule rows.
  ///
  /// At most one active router question per category; that is enforced by
  /// QuestionsService rather than by a partial index, so `prisma migrate dev`
  /// keeps reporting no drift.
  isRouter    Boolean                            @default(false)
  sortOrder   Int                                @default(0)
  isActive    Boolean                            @default(true)
  createdAt   DateTime                           @default(now())
  updatedAt   DateTime                           @updatedAt

  category       ServiceCategory                   @relation(fields: [categoryId], references: [id])
  answers        ServiceRequestAnswer[]
  /// Conditions that govern *this* question's visibility.
  conditions     ServiceRequestQuestionCondition[] @relation("QuestionConditionTarget")
  /// Conditions on other questions that read *this* question's answer.
  dependentRules ServiceRequestQuestionCondition[] @relation("QuestionConditionSource")
  routerRules    ServiceCategoryRouterRule[]

  @@unique([categoryId, key])
  @@index([categoryId, isActive, sortOrder])
}

/// One option of a ROUTER category's routing question, and the category it
/// means.
///
/// The customer never picks a category directly in a routed flow: they answer a
/// question, and the API turns that answer into the category. A target may
/// itself be a ROUTER, which is what makes a two-stage flow (router → router →
/// leaf) expressible without a second concept.
///
/// `questionId` and `targetCategoryId` are checked against each other by
/// CategoriesService: the question must belong to a ROUTER category, and the
/// option key must be one the question actually offers.
model ServiceCategoryRouterRule {
  id               String   @id @default(cuid())
  questionId       String
  /// A key from the routing question's own `options` array.
  optionKey        String
  targetCategoryId String
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  question       ServiceRequestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  targetCategory ServiceCategory        @relation("ServiceCategoryRouterTarget", fields: [targetCategoryId], references: [id], onDelete: Restrict)

  /// One destination per option: a router that could go two ways for one answer
  /// is not a router.
  @@unique([questionId, optionKey])
  @@index([targetCategoryId])
}

/// "Show `question` only when `sourceQuestion` was answered with one of
/// `expectedValues`."
///
/// Normalised rather than a JSON blob so it can be validated at write time and
/// joined at read time: the source has to be a SELECT or MULTI_SELECT question
/// of the *same* category, and every expected value has to be one of its option
/// keys. Several rows on one question are combined with AND.
///
/// The source must also sort before its target. That single rule is what makes
/// the graph acyclic by construction, so evaluating visibility is one ordered
/// pass and never a cycle search.
model ServiceRequestQuestionCondition {
  id               String                     @id @default(cuid())
  questionId       String
  sourceQuestionId String
  /// One or many. A SELECT source matches when its answer is in the list; how a
  /// MULTI_SELECT source is read is what `matchMode` decides.
  expectedValues   String[]
  /// ANY (default) or ALL — see QuestionConditionMatchMode.
  ///
  /// The default is what makes this column additive in meaning as well as in
  /// shape: every rule written before it existed meant "any of these", and
  /// still does.
  matchMode        QuestionConditionMatchMode @default(ANY)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  question       ServiceRequestQuestion @relation("QuestionConditionTarget", fields: [questionId], references: [id], onDelete: Cascade)
  sourceQuestion ServiceRequestQuestion @relation("QuestionConditionSource", fields: [sourceQuestionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sourceQuestionId])
  @@index([sourceQuestionId])
}

model ServiceRequest {
  id                          String               @id @default(cuid())
  requestNumber               String?              @unique
  /// The category the request really belongs to — always a LEAF, and the only
  /// one provider matching, the offer credit cost and the accepted work scope
  /// ever read. A routed flow resolves to it on the server; an unrouted one
  /// simply starts there.
  categoryId                  String
  /// The category the customer picked first, when that is not the same one.
  ///
  /// NULL means "the entry was the category" — which is what every request
  /// created before routing existed carries, and what an unrouted request still
  /// carries today. It is analytics and audit only: nothing about matching,
  /// pricing or scope reads it.
  entryCategoryId             String?
  customerId                  String?
  status                      ServiceRequestStatus @default(SUBMITTED)
  customerName                String
  customerPhone               String
  customerEmail               String?
  city                        String
  district                    String
  neighborhood                String?
  addressNote                 String?
  budgetMin                   Int?
  budgetMax                   Int?
  preferredDate               DateTime?
  urgency                     String?
  description                 String?
  qualityScore                Int                  @default(0)
  qualityScoreBreakdown       Json?
  moderatedAt                 DateTime?
  moderationNote              String?
  rejectionReason             String?
  /// When the customer proved control of customerPhone via a one-time code.
  /// NULL means "not verified" — including every request created before phone
  /// verification existed. What that blocks depends on REQUIRE_PHONE_VERIFICATION.
  phoneVerifiedAt             DateTime?
  /// When moderation approved the request — the single clock the expiry and
  /// reminder schedulers run on.
  ///
  /// NULL means "no trustworthy approval time": every request approved before
  /// this column existed carries NULL, because neither submittedAt nor
  /// moderatedAt is the approval moment (moderatedAt is rewritten by any later
  /// moderation edit). Those rows are deliberately never picked up by the
  /// schedulers rather than backfilled with a guess.
  ///
  /// It is written once, when the status becomes APPROVED, and is never cleared
  /// again — a later MATCHED/COMPLETED/CANCELLED transition keeps it as audit.
  approvedAt                  DateTime?
  /// When the "your request is about to expire" reminder was claimed.
  ///
  /// Written by a conditional update that only matches while it is still NULL,
  /// which is what makes one reminder per request the database-level guarantee.
  /// It records the claim, not the delivery: a failed send stays visible in
  /// NotificationLog and never re-opens the request for a second reminder.
  reminderSentAt              DateTime?
  /// Which version of the contact-sharing disclosure the customer confirmed
  /// having read, and when.
  ///
  /// NULL means "no acceptance on file" — which is what every request created
  /// before this column existed carries, deliberately: those customers were
  /// never shown the text, so their details must stay closed even after the
  /// feature is switched on. There is no backfill.
  ///
  /// This records a technical acknowledgement, not a legal basis on its own.
  /// CONTACT_SHARING_ENABLED may only be turned on once approved disclosure
  /// content exists behind CONTACT_DISCLOSURE_URL.
  contactDisclosureVersion    String?
  contactDisclosureAcceptedAt DateTime?
  /// The vitrin lead this request was opened from, when it was.
  ///
  /// **Never cleared.** It is the record of where the request came from, and a
  /// fallback that erased it would destroy the only evidence that a placement
  /// produced this lead — the number a provider's renewal decision rests on.
  showcaseLeadId              String?              @unique
  /// The only provider allowed to see this request, when one is named.
  ///
  /// The gate, and deliberately a *second* column rather than a reading of the
  /// one above: one says where the request came from and never changes, the
  /// other says who may see it and changes exactly once. Merged into one
  /// column, releasing a lead to the market would erase its origin.
  ///
  /// NULL is the ordinary marketplace request — every request that predates
  /// vitrin, and every request that will ever be submitted through the normal
  /// form. Nothing about matching, fan-out or offer pricing changes for those.
  /// The single writer that clears it is the customer's explicit RELEASE
  /// decision after an SLA breach; a breach on its own never does.
  directShowcaseProviderId    String?
  /// The single accepted offer. Unique so the request can never point at two
  /// winners; the accept cascade is what writes it.
  matchedOfferId              String?              @unique
  matchedAt                   DateTime?
  completedAt                 DateTime?
  cancelledAt                 DateTime?
  expiredAt                   DateTime?
  submittedAt                 DateTime             @default(now())
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  category               ServiceCategory        @relation(fields: [categoryId], references: [id])
  entryCategory          ServiceCategory?       @relation("ServiceRequestEntryCategory", fields: [entryCategoryId], references: [id])
  customer               User?                  @relation(fields: [customerId], references: [id])
  answers                ServiceRequestAnswer[]
  offers                 Offer[]
  matchedOffer           Offer?                 @relation("ServiceRequestMatchedOffer", fields: [matchedOfferId], references: [id])
  phoneVerifications     PhoneVerification[]
  notificationLogs       NotificationLog[]
  contactRevealEvent     ContactRevealEvent?
  messageThread          MessageThread?
  /// Restrict both ways. The lead carries the customer's urgency choice, the
  /// SLA they were promised and their fallback decision; none of it may be
  /// removed by removing something else.
  showcaseLead           ShowcaseLead?          @relation("ServiceRequestShowcaseLead", fields: [showcaseLeadId], references: [id], onDelete: Restrict)
  showcaseLeadSource     ShowcaseLead?          @relation("ShowcaseLeadRequest")
  directShowcaseProvider ProviderProfile?       @relation("ServiceRequestDirectShowcaseProvider", fields: [directShowcaseProviderId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([entryCategoryId])
  @@index([customerId])
  @@index([status])
  @@index([city, district])
  @@index([submittedAt])
  @@index([status, submittedAt])
  @@index([phoneVerifiedAt])
  /// Expiry scan: "APPROVED and approved before <cutoff>".
  @@index([status, approvedAt])
  /// Reminder scan: the same window, narrowed to rows that have not been
  /// claimed yet. reminderSentAt leads approvedAt because it is the equality
  /// predicate.
  @@index([status, reminderSentAt, approvedAt])
  /// The direct-lead gate, as the discovery query reads it: "requests reserved
  /// for this provider, in this state".
  @@index([directShowcaseProviderId, status])
}

/// The moment a matched request opened both sides' contact details to each
/// other, recorded once and never again.
///
/// It is written inside the accept transaction, so a matched request either
/// carries its audit row or the match did not happen at all — there is no
/// window in which contact details are reachable without a record of why.
///
/// `requestId` and `offerId` are both unique: one reveal per request, and one
/// per offer. The application also checks the row against
/// ServiceRequest.matchedOfferId, so an event can never point at an offer that
/// did not win.
///
/// Immutable by contract. Nothing in the application updates or deletes a row
/// here, and no endpoint exposes either operation.
model ContactRevealEvent {
  id                String   @id @default(cuid())
  requestId         String   @unique
  offerId           String   @unique
  /// Nullable because a request need not belong to a signed-in account: an
  /// unclaimed guest request has no customer user, and the event still has to
  /// record that the reveal happened.
  customerUserId    String?
  providerId        String
  revealedAt        DateTime @default(now())
  /// The disclosure version in force at the moment of the reveal. Copied from
  /// the request's own acceptance, so a later version bump cannot rewrite what
  /// this customer actually agreed to.
  disclosureVersion String
  createdAt         DateTime @default(now())

  request  ServiceRequest  @relation(fields: [requestId], references: [id])
  offer    Offer           @relation(fields: [offerId], references: [id])
  customer User?           @relation(fields: [customerUserId], references: [id])
  provider ProviderProfile @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([customerUserId])
  @@index([revealedAt])
}

/// A one-time code proving control of a phone number.
///
/// The code itself is never stored: only a bcrypt hash of it, so a database
/// dump cannot be replayed. There is deliberately NO unique constraint on
/// codeHash — six digits collide often, and a unique index would leak that a
/// code is already in flight elsewhere.
model PhoneVerification {
  id              String    @id @default(cuid())
  /// Digits-and-plus normalisation of the request's customerPhone.
  normalizedPhone String
  codeHash        String
  expiresAt       DateTime
  consumedAt      DateTime?
  /// Wrong codes entered against this row. At the limit the row locks.
  attemptCount    Int       @default(0)
  lockedUntil     DateTime?
  /// How many codes have been issued in this request/phone conversation.
  resendCount     Int       @default(0)
  lastSentAt      DateTime  @default(now())
  requestId       String?
  ipAddress       String?
  userAgent       String?
  /// True when the row was consumed with the local/staging test code rather
  /// than the code that was sent (see phone-verification-test-bypass.config.ts).
  /// The audit distinction and nothing more: no code, no list, no reason.
  /// Additive, defaulting to false, so every row written before it existed
  /// reads as a real verification — which is what it was.
  verifiedByTestBypass Boolean @default(false)
  createdAt       DateTime  @default(now())

  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// Per-phone send budget and "find the active code" lookups.
  @@index([normalizedPhone, createdAt])
  /// Per-IP send budget.
  @@index([ipAddress, createdAt])
  @@index([requestId])
  /// Cleanup of expired rows.
  @@index([expiresAt])
}

/// Audit trail of outbound messages.
///
/// Deliberately stores nothing that could be replayed or that identifies the
/// recipient beyond a mask: no code, no token, no action URL, no message body,
/// no raw phone or e-mail address.
model NotificationLog {
  id                String              @id @default(cuid())
  channel           NotificationChannel
  template          String
  /// e.g. "u***@example.com" or "+90 *** *** ** 34".
  maskedRecipient   String
  status            NotificationStatus  @default(PENDING)
  providerMessageId String?
  /// Safe, enumerable failure class — never a raw provider error string.
  errorCode         String?
  requestId         String?
  userId            String?
  /// Which provider application a message was about — the audit link behind
  /// "how many claim invitations went out for this application, and did the
  /// last one leave the building".
  ///
  /// Nullable and never backfilled: every row written before this column
  /// existed carries NULL, and messages that are not about a provider still do.
  /// It is an id and nothing else — no address, no token, no action URL — so it
  /// does not widen what this table holds.
  providerId        String?
  /// The state transition this message belongs to, as a short opaque string —
  /// "offer-accepted:<offerId>", "request-approved:<requestId>:<approvedAt>".
  ///
  /// Unique together with `template`, which is what makes "one mail per real
  /// transition" a database guarantee rather than an application convention: a
  /// retry, a second scheduler, or a double-clicked admin action all collide on
  /// the index and send nothing.
  ///
  /// Nullable because it is not a fact about every message. The three templates
  /// that predate it carry NULL, and PostgreSQL treats NULLs as distinct in a
  /// unique index, so any number of them coexist.
  ///
  /// It is derived from ids and timestamps only. No address, no token, no
  /// amount — nothing that would widen what this table holds.
  dedupeKey         String?
  /// How many times this one message has been handed to a transport — the
  /// first dispatch plus every admin-triggered retry of the same row.
  ///
  /// Starts at 1 because a row only exists once a send has been attempted, and
  /// the default backfills rows written before the column existed with the one
  /// attempt they really had.
  attemptCount      Int                 @default(1)
  /// When the most recent attempt was claimed. Distinct from sentAt/failedAt:
  /// those record an outcome, this records that the work started, so a row
  /// stuck in PENDING still says when.
  lastAttemptAt     DateTime?
  createdAt         DateTime            @default(now())
  sentAt            DateTime?
  failedAt          DateTime?

  request  ServiceRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@unique([template, dedupeKey])
  @@index([channel, createdAt])
  @@index([status, createdAt])
  @@index([template, createdAt])
  /// The expiry outbox's sweep: "PENDING rows of these two templates, oldest
  /// claim first". Leads on `template` because that is the selective column —
  /// the sweep looks at two of twenty-eight — and carries `lastAttemptAt` so
  /// the never-attempted rows and the ones whose claim has gone stale are both
  /// found by the index rather than by a scan of every PENDING row.
  @@index([template, status, lastAttemptAt])
  @@index([requestId])
  @@index([userId])
  @@index([providerId])
}

model ServiceRequestAnswer {
  id            String   @id @default(cuid())
  requestId     String
  questionId    String
  questionKey   String
  questionLabel String
  questionType  String
  value         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  request  ServiceRequest         @relation(fields: [requestId], references: [id])
  question ServiceRequestQuestion @relation(fields: [questionId], references: [id])

  @@unique([requestId, questionId])
  @@index([questionId])
}

model ProviderProfile {
  id              String         @id @default(cuid())
  // A platform account may own at most one provider profile. The column stays
  // nullable so guest (unclaimed) applications remain possible: PostgreSQL
  // treats NULLs as distinct in a unique index, so the constraint only binds
  // rows where userId IS NOT NULL.
  userId          String?        @unique
  businessName    String
  contactName     String
  phone           String
  email           String?
  taxType         String?
  taxNumber       String?
  /// The single service location a provider used to have, kept as it is.
  ///
  /// This is a historical field, not a newly-defined one. Before
  /// `ProviderServiceArea` carried a list, these two columns *were* the
  /// provider's service area — the form asked for one place and matching read
  /// it — and the screens that print them have always printed them under
  /// "adres". This work does not redefine what they mean; there is no separate
  /// business-address model to promote them into, and inventing one would be a
  /// claim about data nobody ever collected under that name. (There is no
  /// `neighborhood` column here to go with them: the single service area was
  /// only ever a province and a district.)
  ///
  /// What did change is what reads them. Coverage is `ProviderServiceArea` and
  /// nothing else — `matchesProviderArea` takes area rows and no profile — and
  /// the migration copied this pair into an area row for every provider that
  /// had none, so no provider depends on it being read as an implicit area any
  /// more. They stay for backwards compatibility: existing screens, exports and
  /// filters that print them keep working, and no new write derives coverage
  /// from them.
  ///
  /// Still required and still canonical, resolved against the shipped location
  /// list like every other place name the product stores.
  city            String
  district        String
  addressNote     String?
  description     String?
  status          ProviderStatus @default(PENDING_REVIEW)
  moderationNote  String?
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  suspendedAt     DateTime?
  /// When a guest application became owned by a platform account through the
  /// claim flow, and never for any other reason.
  ///
  /// NULL therefore means two different things that a reader must not confuse:
  /// an application nobody owns yet (`userId` is also NULL), or a profile that
  /// was born owned because a signed-in provider created it (`userId` is set).
  /// `userId` says who owns it; this says whether a claim is how that happened.
  ///
  /// Written once, inside the claim transaction, and never cleared.
  claimedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user                          User?                              @relation(fields: [userId], references: [id])
  serviceCategories             ProviderServiceCategory[]
  serviceAreas                  ProviderServiceArea[]
  offers                        Offer[]
  creditTransactions            ProviderCreditTransaction[]
  manualOfferRefunds            ManualOfferRefundAudit[]
  packagePurchases              PackagePurchase[]
  contactRevealEvents           ContactRevealEvent[]
  claimTokens                   ProviderClaimToken[]
  notificationLogs              NotificationLog[]
  messageThreads                MessageThread[]
  packageEntitlements           ProviderPackageEntitlement[]
  showcaseCards                 ShowcaseCard[]
  showcaseAutoPublish           ShowcaseCardAutoPublishAudit[]
  showcaseWithdrawals           ShowcaseSubmissionWithdrawal[]
  showcasePlacements            ShowcasePlacement[]
  showcaseLeads                 ShowcaseLead[]
  showcasePriceTermsAcceptances ShowcaseCardPriceTermsAcceptance[]
  showcasePackageTermsAcceptances ShowcasePackageTermsAcceptance[]
  showcaseEntitlements          ShowcaseEntitlement[]
  directShowcaseRequests        ServiceRequest[]                   @relation("ServiceRequestDirectShowcaseProvider")

  @@index([status])
  @@index([city])
  @@index([district])
  @@index([phone])
  @@index([email])
}

model ProviderServiceCategory {
  id         String   @id @default(cuid())
  providerId String
  categoryId String
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  @@unique([providerId, categoryId])
  @@index([categoryId])
}

/// One area a provider covers. A provider has many, and together they are the
/// *only* thing request matching reads: `ProviderProfile.city`/`district` is
/// the historical single service area, and since the migration copied it into a
/// row here for every provider that lacked one, nothing consults it for
/// coverage any more.
///
/// Three partial unique indexes live in raw SQL, in the
/// add_provider_service_area_scope migration, because Prisma cannot express a
/// partial index in this schema:
///
///   ProviderServiceArea_one_city_area   (providerId, city)                        WHERE scope = 'CITY'
///   ProviderServiceArea_one_district_area (providerId, city, district)            WHERE scope = 'DISTRICT'
///   ProviderServiceArea_one_neighborhood_area (providerId, city, district, neighborhood) WHERE scope = 'NEIGHBORHOOD'
///
/// They replace the plain `@@unique([providerId, city, district, neighborhood])`
/// this model used to carry, which enforced nothing for the two scopes that
/// leave a column NULL: a provider could hold "all of İstanbul" twice and the
/// database was happy.
///
/// A CHECK constraint — ProviderServiceArea_scope_levels — pins the scope to
/// the levels it claims, so no writer can store a NEIGHBORHOOD row with a NULL
/// district or a CITY row that secretly names one.
///
/// The indexes bind duplicates and nothing else. A provider may hold both "all
/// of İstanbul" and "İstanbul/Kadıköy": redundant, not contradictory, and
/// matching reads it as the wider of the two. Rows like that survived the
/// migration untouched, so the API's overlap rule refuses a *new* one while
/// leaving a stored pair alone — otherwise its owner could not save their own
/// profile.
model ProviderServiceArea {
  id           String                   @id @default(cuid())
  providerId   String
  /// Derived from the levels below by the API, never taken from a client.
  scope        ProviderServiceAreaScope
  city         String
  district     String?
  neighborhood String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([city])
  @@index([district])
}

model Offer {
  id                          String                  @id @default(cuid())
  offerNumber                 String?                 @unique
  requestId                   String
  providerId                  String
  status                      OfferStatus             @default(SUBMITTED)
  priceAmount                 Int
  currency                    String                  @default("TRY")
  estimatedStartDate          DateTime?
  estimatedCompletionDate     DateTime?
  message                     String
  warrantyNote                String?
  internalNote                String?
  creditCost                  Int                     @default(1)
  /// Which right paid for this offer.
  ///
  /// Written by the entitlement resolver in the same transaction that charged
  /// it, so "no credit moved" and "an unlimited period covered it" are never
  /// the same reading. Backfilled to ONE_TIME_CREDIT for every offer that
  /// predates entitlements, which is what they all spent.
  entitlementSource           OfferEntitlementSource?
  /// The period entitlement that covered this offer, when one did. NULL for a
  /// ONE_TIME_CREDIT offer.
  entitlementId               String?
  creditSpentTransactionId    String?
  creditRefundedTransactionId String?
  creditRefundedAt            DateTime?
  creditRefundReason          String?
  /// Whether this offer is governed by the 48-hour unviewed-offer refund rule.
  ///
  /// The column IS the opt-in. Only the offer-creation path that shipped with
  /// the rule writes `true`; every offer that predates it keeps the migration's
  /// `false` default and is permanently outside the policy — no reader compares
  /// `submittedAt` against a deploy timestamp to guess, because a deploy time is
  /// not a fact the database holds and a clock skew would silently start paying
  /// out on history.
  ///
  /// A `false` here is not "not refundable yet"; it is "this offer was sold
  /// under the old terms", which is why the provider panel renders no policy
  /// state at all for those rows rather than inventing one.
  unviewedRefundPolicy        Boolean                 @default(false)
  /// The refund window this offer was sold under, in whole hours, and the exact
  /// moment its credit becomes refundable — both snapshotted when the offer is
  /// created and never recomputed.
  ///
  /// The snapshot is the whole point. `OperationsSettings` holds what the *next*
  /// offer is sold under; an offer created while the window was 48 hours keeps
  /// 48 hours forever, even if an administrator sets 72 the next morning. The
  /// worker reads `unviewedRefundEligibleAt` and never the live setting, so
  /// changing the term cannot move a promise that has already been made — in
  /// either direction.
  ///
  /// NULL on every offer outside the policy. Backfilled to 48 hours (and to
  /// `submittedAt` + 48 hours) for the in-policy offers created before these
  /// columns existed, which is exactly the rule they were already governed by.
  /// A NULL here on an in-policy offer would be a missing schedule rather than
  /// an eligible one: `lte` never matches NULL, so such a row is never paid.
  unviewedRefundWindowHours   Int?
  unviewedRefundEligibleAt    DateTime?
  /// When something other than a customer view closed this offer's refund
  /// eligibility for good, and why.
  ///
  /// The worker excludes a non-NULL `refundBlockedAt` exactly as it excludes a
  /// non-NULL `viewedAt`, so eligibility never rests on `viewedAt` alone. The
  /// pair is written atomically with the status change that caused it.
  refundBlockedAt             DateTime?
  refundBlockedReason         OfferRefundBlockReason?
  submittedAt                 DateTime                @default(now())
  viewedAt                    DateTime?
  acceptedAt                  DateTime?
  rejectedAt                  DateTime?
  rejectionReason             OfferRejectionReason?
  withdrawnAt                 DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  request            ServiceRequest              @relation(fields: [requestId], references: [id])
  provider           ProviderProfile             @relation(fields: [providerId], references: [id])
  entitlement        ProviderPackageEntitlement? @relation(fields: [entitlementId], references: [id])
  matchedForRequest  ServiceRequest?             @relation("ServiceRequestMatchedOffer")
  contactRevealEvent ContactRevealEvent?
  messageThread      MessageThread?
  manualRefundAudit  ManualOfferRefundAudit?
  /// The vitrin lead this offer answered, when it answered one. Unique on the
  /// lead's side: a lead has one response.
  showcaseLead       ShowcaseLead?               @relation("ShowcaseLeadRespondedOffer")
  // A PostgreSQL partial unique index — "Offer_one_accepted_per_request",
  // UNIQUE ("requestId") WHERE status = 'ACCEPTED' — is created by the
  // add_request_matching migration. Prisma cannot express partial indexes in
  // this schema, so it lives in raw SQL; it is the database-level backstop that
  // makes a second accepted offer on a request unrepresentable even if the
  // application guard is bypassed.

  @@unique([providerId, requestId])
  @@index([requestId])
  @@index([providerId])
  @@index([status])
  @@index([submittedAt])
  @@index([creditSpentTransactionId])
  @@index([creditRefundedTransactionId])
  @@index([rejectionReason])
  @@index([entitlementId, submittedAt])
  // The worker's candidate query, in its own selectivity order: policy offers
  // only, unviewed only, oldest first.
  @@index([unviewedRefundPolicy, viewedAt, submittedAt])
  // The same query after the snapshot: policy offers only, unviewed only,
  // ordered by the moment each one becomes eligible rather than by a window the
  // reader would have to assume.
  @@index([unviewedRefundPolicy, viewedAt, unviewedRefundEligibleAt], map: "Offer_refund_schedule_idx")
  @@index([refundBlockedAt])
}

/// What a purchasable offer package sells.
///
/// ONE_TIME_CREDITS is everything this table held before the enum existed: a
/// bundle of credits that lands in the provider's ledger and never expires. The
/// two period products sit beside it and change nothing about it.
///
/// MONTHLY_QUOTA sells a credit quota that lives for one 30-day period and does
/// not carry over. CATEGORY_UNLIMITED sells unmetered offering for 30 days, but
/// only inside the category scope snapshotted at purchase time.
enum OfferPackageType {
  ONE_TIME_CREDITS
  MONTHLY_QUOTA
  CATEGORY_UNLIMITED
}

/// Where a period entitlement stands right now.
///
/// ACTIVE    — inside its period and usable. `endAt` still decides: the
///             resolver never trusts the status alone.
/// EXPIRED   — the period ended. Reached by the sweeper, and assumed by every
///             reader the moment `endAt` passes, so a stopped sweeper cannot
///             hand out an extra day.
/// PAST_DUE  — a renewal charge was attempted at period end and did not
///             succeed. It grants nothing; it exists so "the money failed" is
///             distinguishable from "the period simply ran out".
/// CANCELLED — auto-renew was cancelled AND the period has since ended.
///             Cancelling on its own never leaves ACTIVE early.
enum ProviderEntitlementStatus {
  ACTIVE
  EXPIRED
  PAST_DUE
  CANCELLED
}

/// The outcome of one renewal attempt.
///
/// UNSUPPORTED is a first-class outcome rather than a failure dressed up as
/// one: this build's payment adapters cannot charge a stored payment method at
/// all, and an attempt row that said FAILED would read as "the card was
/// declined" to whoever audits it later.
enum EntitlementRenewalStatus {
  SUCCEEDED
  FAILED
  UNSUPPORTED
}

/// Why a renewal attempt did not produce a new period, as a closed set of short
/// codes.
///
/// Never a payment-provider response body, never a decline message, never
/// anything about a card. The provider-facing screens map these onto neutral
/// wording and the admin screens show the code itself.
enum EntitlementRenewalFailureCode {
  PROVIDER_UNSUPPORTED
  PAYMENT_METHOD_MISSING
  PAYMENT_DECLINED
  PROVIDER_UNAVAILABLE
  PROVIDER_REJECTED
  PROVIDER_TIMEOUT
  AUTO_RENEW_DISABLED
  ENTITLEMENT_NOT_RENEWABLE
}

/// Which right paid for an offer, decided once by the entitlement resolver and
/// then written on the offer.
///
/// Existing offers are backfilled to ONE_TIME_CREDIT, which is what every offer
/// submitted before this enum existed actually spent.
///
/// SHOWCASE_PLACEMENT is the fourth and it is not a package at all: it is the
/// direct vitrin lead, where the provider already paid for the placement the
/// lead came through and charging them a second time for answering it would be
/// the double charge this product's lead economics exist to refuse. It is
/// reachable on exactly one condition — `ServiceRequest.directShowcaseProviderId`
/// equals the offering provider — and the moment a fallback clears that gate
/// every provider, the card owner included, pays the ordinary price.
enum OfferEntitlementSource {
  UNLIMITED
  MONTHLY_QUOTA
  ONE_TIME_CREDIT
  SHOWCASE_PLACEMENT
}

model OfferCreditPackage {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  /// Credits handed to the ledger when a ONE_TIME_CREDITS package settles.
  ///
  /// Zero for the two period types, which grant an entitlement rather than a
  /// balance. A database CHECK keeps the pairing honest in both directions —
  /// see the add_offer_package_entitlements migration.
  creditAmount    Int
  priceAmount     Int
  currency        String           @default("TRY")
  description     String?
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  /// What this package sells. Defaults to the only thing the table used to
  /// hold, so every existing row keeps its exact meaning.
  type            OfferPackageType @default(ONE_TIME_CREDITS)
  /// The credit quota one MONTHLY_QUOTA period carries. NULL for every other
  /// type; a CHECK enforces both halves.
  quotaCredits    Int?
  /// How long one period lasts, in whole days. NULL for ONE_TIME_CREDITS,
  /// which does not expire. Stored rather than hard-coded so a purchased
  /// entitlement can snapshot the number it was actually sold under, but the
  /// admin API only ever writes PACKAGE_PERIOD_DAYS (30).
  periodDays      Int?
  /// How many offers a CATEGORY_UNLIMITED period allows per day. NULL means no
  /// daily cap. Kept nullable rather than defaulted so "unset" stays visible.
  dailyOfferLimit Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  purchases       PackagePurchase[]
  /// Which categories a CATEGORY_UNLIMITED package is allowed to cover. Empty
  /// for every other type.
  scopeCategories OfferPackageScopeCategory[]
  entitlements    ProviderPackageEntitlement[]

  @@index([isActive, sortOrder])
  @@index([type, isActive, sortOrder])
}

/// A category an admin has put inside a CATEGORY_UNLIMITED package's scope.
///
/// The row can only exist for a category whose `unlimitedPackageEligible` flag
/// is set, which is the whole of the "regulated categories are not sold as
/// unlimited by default" rule: nothing is eligible until somebody says so.
///
/// This is the package *definition*. What a provider bought is snapshotted onto
/// ProviderPackageEntitlementScope and never reads back through here, so
/// editing a package cannot widen or narrow a period somebody already paid for.
model OfferPackageScopeCategory {
  id         String   @id @default(cuid())
  packageId  String
  categoryId String
  createdAt  DateTime @default(now())

  package  OfferCreditPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  category ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([packageId, categoryId])
  @@index([categoryId])
}

/// One provider's payment for one product — a credit package or a vitrin
/// placement, and never both.
///
/// **There is one money rail and there are two catalogues.** A second purchase
/// table for vitrin would have been the easier change and the wrong one:
/// `providerOrderId` and `paymentReference` are unique *on this table*, which
/// is what makes "one Lemon order settles one purchase" a database fact. Split
/// across two tables, one order could close a row in each and no constraint
/// anywhere would see it.
///
/// `kind` is the discriminator and three CHECK constraints hold it honest — see
/// the add_purchase_kind_discriminator migration. The one worth naming here is
/// `PackagePurchase_showcase_grants_no_credit`: a vitrin purchase may never
/// carry a credit amount or a ledger row, so a settlement path that forgot to
/// branch fails on a constraint rather than silently handing out offer credit.
model PackagePurchase {
  id                             String                @id @default(cuid())
  purchaseNumber                 String?               @unique
  providerId                     String
  /// The offer package this purchase bought. NULL exactly on a
  /// SHOWCASE_PACKAGE row, and NOT NULL on every OFFER_PACKAGE one — including
  /// every row that predates the discriminator, which is why dropping the NOT
  /// NULL changed nothing about what an existing purchase means.
  packageId                      String?
  /// What was bought. Defaults to OFFER_PACKAGE, which is what this table held
  /// before vitrin existed, so the default *is* the backfill.
  kind                           PackagePurchaseKind   @default(OFFER_PACKAGE)
  /// The vitrin catalogue row, and the card and version this placement was
  /// bought for. All four are NULL on an OFFER_PACKAGE row and all four are
  /// required on a SHOWCASE_PACKAGE one.
  ///
  /// `showcaseCardVersionId` is the version that was live when the checkout was
  /// opened. The placement pins its own version at settlement and may be
  /// re-pinned later; this column is the record of what the provider was
  /// looking at when they paid, and it never moves.
  showcasePackageId              String?
  showcaseCardId                 String?
  showcaseCardVersionId          String?
  durationDaysSnapshot           Int?
  /// The price-responsibility acceptance that was in force when this checkout
  /// was opened. NULL on an OFFER_PACKAGE row and required on a
  /// SHOWCASE_PACKAGE one, which the extended
  /// `PackagePurchase_showcase_card_matches_kind` CHECK enforces.
  ///
  /// Written inside the same transaction that creates the row, from an
  /// acceptance read in that transaction. That is what makes "a vitrin purchase
  /// exists" and "the buyer had accepted the terms then in force" one fact
  /// rather than two that a later read has to reconcile: there is no ordering
  /// of writes in which the purchase exists and the acceptance does not.
  ///
  /// It names the acceptance rather than copying its version string, because
  /// the acceptance row carries the text as well as the version — and the text
  /// is what a customer is eventually shown.
  showcasePriceTermsAcceptanceId String?
  /// The provider-level acceptance a package-first vitrin purchase was opened
  /// against. Exactly one of this and `showcasePriceTermsAcceptanceId` is set on
  /// a SHOWCASE_PACKAGE row — the legacy card-bound shape or the package-first
  /// one — and the CHECK `PackagePurchase_showcase_card_matches_kind` says so.
  showcasePackageTermsAcceptanceId String?
  status                         PackagePurchaseStatus @default(PENDING)
  creditAmountSnapshot           Int
  priceAmountSnapshot            Int
  currencySnapshot               String                @default("TRY")
  packageNameSnapshot            String
  providerNote                   String?
  adminNote                      String?
  mockPaymentReference           String?
  mockPaymentFailureReason       String?
  // Which PaymentProviderPort adapter opened this purchase's checkout. Only
  // ever a kind from the allow-list in payments/payment-provider.config.ts.
  paymentProvider                String?
  // This application's own opaque correlation token, handed to the provider as
  // checkout metadata and matched back on the webhook. Unique so one token can
  // never stand for two purchases.
  paymentReference               String?               @unique
  // Opaque provider-side identifiers. Never a payload, never a customer detail.
  providerCheckoutId             String?
  providerCheckoutUrl            String?
  providerCheckoutExpiresAt      DateTime?
  // The provider's order id, unique across the table: the database-level half of
  // the guarantee that one paid order loads credits exactly once.
  providerOrderId                String?               @unique
  // Why opening a checkout failed, as one of a closed set of short codes. Never
  // a provider response body.
  paymentFailureCode             String?
  // Set by refund/chargeback webhooks, which never move money or credits on
  // their own in this phase. It is a flag for a human, nothing else.
  manualReviewReason             String?
  manualReviewAt                 DateTime?
  paidAt                         DateTime?
  failedAt                       DateTime?
  cancelledAt                    DateTime?
  expiredAt                      DateTime?
  refundedAt                     DateTime?
  creditTransactionId            String?
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt

  provider                     ProviderProfile                   @relation(fields: [providerId], references: [id])
  package                      OfferCreditPackage?               @relation(fields: [packageId], references: [id])
  /// Restrict on all three: a catalogue row, a card or a version that a
  /// settled payment points at is part of the record of what was sold, and a
  /// cascade here would erase the answer to "what did this provider pay for".
  showcasePackage              ShowcasePackage?                  @relation(fields: [showcasePackageId], references: [id], onDelete: Restrict)
  showcaseCard                 ShowcaseCard?                     @relation(fields: [showcaseCardId], references: [id], onDelete: Restrict)
  showcaseCardVersion          ShowcaseCardVersion?              @relation(fields: [showcaseCardVersionId], references: [id], onDelete: Restrict)
  /// Restrict for the same reason as the three above: it is part of the record
  /// of what was sold and on what terms.
  showcasePriceTermsAcceptance ShowcaseCardPriceTermsAcceptance? @relation(fields: [showcasePriceTermsAcceptanceId], references: [id], onDelete: Restrict)
  showcasePackageTermsAcceptance ShowcasePackageTermsAcceptance? @relation(fields: [showcasePackageTermsAcceptanceId], references: [id], onDelete: Restrict)
  /// The publication right this purchase produced, when it was package-first.
  showcaseEntitlement          ShowcaseEntitlement?
  /// The period this purchase paid for, when it paid for one. A ONE_TIME_CREDITS
  /// purchase has none.
  entitlement                  ProviderPackageEntitlement?       @relation("PackagePurchaseEntitlement")
  /// The placement this purchase paid for, when it was a vitrin purchase.
  /// Unique on the placement side: one payment, one placement.
  showcasePlacement            ShowcasePlacement?
  /// The renewal attempt this purchase settled, when it was a renewal rather
  /// than a first purchase.
  renewalAttempt               PackageRenewalAttempt?

  @@index([providerId])
  @@index([packageId])
  @@index([status])
  @@index([createdAt])
  @@index([mockPaymentReference])
  @@index([paymentProvider, status])
  @@index([kind, status])
  @@index([showcaseCardId])
  @@index([showcasePriceTermsAcceptanceId])
  @@index([showcasePackageTermsAcceptanceId])
}

/**
 * One audit row per payment-provider webhook event that passed signature
 * verification.
 * Deliberately narrow. `eventKey` is the provider's own opaque identity for the
 * event object (never a customer detail), and the unique index on it with the
 * provider is what makes a redelivered event a no-op rather than a second credit
 * load. `detail` carries a short machine code such as AMOUNT_MISMATCH — never a
 * raw payload, a signature, an address or a name.
 */
/// One row per provider event, not per delivery.
///
/// The provider re-sends an event when its first delivery did not settle, so
/// the row carries the outcome of the latest attempt (`status`, `detail`)
/// alongside the history that outcome would otherwise erase: when the event was
/// first seen, how many times it arrived, what the first refusal was, and when
/// it was finally resolved. `PROCESSED` is terminal — a later delivery updates
/// the attempt counters and nothing else.
///
/// Nothing here is a payload. No raw body, no signature, no credential, no
/// correlation token and no buyer detail: `eventKey` is the provider's own
/// opaque identity for the event object and the codes are the short machine
/// strings in payments-webhook.service.ts.
/// One 30-day period a provider actually bought.
///
/// Everything a period is judged by is snapshotted here at settlement: the
/// price, the quota, the daily cap, the period length and — in
/// ProviderPackageEntitlementScope — the exact set of categories it covers.
/// The package definition is never read back through `packageId` to decide
/// anything: repricing a package, renaming it or widening its scope must leave
/// every period somebody already paid for exactly as it was sold.
///
/// `startAt`/`endAt` are wall-clock instants, never calendar months. A period
/// bought on 27 September ends on 27 October, and a period bought on 31 January
/// ends on 2 March — there is no month arithmetic anywhere in this feature.
///
/// Unused quota does not carry over. The row is not topped up and not extended;
/// a renewal is a new period on the same row (`periodIndex` increments) or a new
/// row, and either way the remaining quota is reset from the snapshot, never
/// added to.
model ProviderPackageEntitlement {
  id                      String                         @id @default(cuid())
  providerId              String
  packageId               String
  /// The purchase that opened this period. Unique, so one settled payment can
  /// never produce two periods — the database half of the idempotency
  /// guarantee that the Serializable settlement transaction is the other half
  /// of.
  purchaseId              String?                        @unique
  type                    OfferPackageType
  packageNameSnapshot     String
  priceAmountSnapshot     Int
  currencySnapshot        String                         @default("TRY")
  /// The quota one period carries, for MONTHLY_QUOTA. NULL for the other types.
  quotaCreditsSnapshot    Int?
  /// What is left of it right now. Decremented under a conditional UPDATE, so
  /// two offers racing for the last credit cannot both win.
  remainingQuota          Int?
  dailyOfferLimitSnapshot Int?
  periodDaysSnapshot      Int
  startAt                 DateTime
  endAt                   DateTime
  status                  ProviderEntitlementStatus      @default(ACTIVE)
  /// Which period this is. 0 is the purchased one; a successful renewal
  /// increments it. Half of the renewal idempotency key.
  periodIndex             Int                            @default(0)
  /// Off unless the provider turned it on themselves, in a separate action from
  /// buying. There is no code path that sets this at purchase time.
  autoRenewEnabled        Boolean                        @default(false)
  /// When that separate consent was given. Cleared when auto-renew is turned
  /// off again, so the column is never a record of a consent that no longer
  /// stands.
  autoRenewConsentAt      DateTime?
  /// The payment provider's own reference for a stored payment method, and
  /// nothing else. Never a card number, never a CVC, never a PAN fragment, and
  /// never rendered to anyone but a SUPER_ADMIN.
  ///
  /// Always NULL in this build: no adapter here can store or charge a payment
  /// method. The column exists so enabling that capability is a change to the
  /// adapter rather than a migration.
  paymentMethodReference  String?
  paymentProvider         String?
  /// When the provider cancelled auto-renew. Cancelling never shortens the
  /// period: `endAt` is untouched and the status stays ACTIVE until it passes.
  cancelledAt             DateTime?
  lastRenewalAttemptAt    DateTime?
  lastRenewalFailureCode  EntitlementRenewalFailureCode?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  provider        ProviderProfile                   @relation(fields: [providerId], references: [id])
  package         OfferCreditPackage                @relation(fields: [packageId], references: [id])
  purchase        PackagePurchase?                  @relation("PackagePurchaseEntitlement", fields: [purchaseId], references: [id])
  scopes          ProviderPackageEntitlementScope[]
  renewalAttempts PackageRenewalAttempt[]
  offers          Offer[]

  @@index([providerId, status, endAt])
  @@index([packageId])
  @@index([status, endAt])
}

/// One category a bought period covers.
///
/// Two kinds of row, told apart by `selected`:
///
/// - `selected = true`  — a node the package definition named. A GROUP here is
///                        what the provider sees on screen and what the package
///                        was sold as.
/// - `selected = false` — a leaf reached by expanding one of those groups at
///                        purchase time.
///
/// Both are matched against a request's category, which is why adding a child
/// to a group afterwards cannot silently widen a period somebody already paid
/// for: the expansion is frozen here, and the live tree is never walked to
/// answer "is this request in scope".
model ProviderPackageEntitlementScope {
  id                   String              @id @default(cuid())
  entitlementId        String
  categoryId           String
  /// The name as it read at purchase time, so a renamed category does not
  /// rewrite what a past receipt says it covered.
  categoryNameSnapshot String
  categoryKindSnapshot ServiceCategoryKind
  selected             Boolean             @default(true)
  createdAt            DateTime            @default(now())

  entitlement ProviderPackageEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  category    ServiceCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([entitlementId, categoryId])
  @@index([categoryId])
  @@index([entitlementId, selected])
}

/// One attempt to start the next period by charging for it.
///
/// Rows are written for every outcome, including the one this build always
/// produces — UNSUPPORTED, because neither payment adapter here can charge a
/// stored payment method. A failed attempt extends nothing: it never touches
/// `endAt`, and the entitlement moves to PAST_DUE.
///
/// A PostgreSQL partial unique index — "PackageRenewalAttempt_one_success_per_period",
/// UNIQUE ("entitlementId", "periodIndex") WHERE status = 'SUCCEEDED' — is
/// created by the add_offer_package_entitlements migration. Prisma cannot
/// express partial indexes, so it lives in raw SQL; it is what makes two crons,
/// two webhook deliveries or two operators unable to buy the same period twice.
model PackageRenewalAttempt {
  id                     String                         @id @default(cuid())
  entitlementId          String
  /// The period this attempt was trying to open — the entitlement's
  /// `periodIndex` + 1 at the time. Half of the idempotency key.
  periodIndex            Int
  status                 EntitlementRenewalStatus
  failureCode            EntitlementRenewalFailureCode?
  paymentProvider        String?
  /// The payment provider's opaque transaction or order identifier. Never a
  /// payload, never a card detail.
  providerTransactionRef String?
  /// The purchase row this attempt settled through, when the renewal went
  /// through the ordinary checkout path.
  purchaseId             String?                        @unique
  attemptedAt            DateTime                       @default(now())

  entitlement ProviderPackageEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  purchase    PackagePurchase?           @relation(fields: [purchaseId], references: [id])

  @@index([entitlementId, periodIndex])
  @@index([status])
  @@index([attemptedAt])
}

model PaymentWebhookEvent {
  id         String                    @id @default(cuid())
  provider   String
  eventKey   String
  eventName  String
  status     PaymentWebhookEventStatus
  purchaseId String?
  detail     String?
  createdAt  DateTime                  @default(now())

  /// How many deliveries of this event have been handled.
  attemptCount     Int       @default(1)
  /// When the most recent delivery was handled.
  lastAttemptAt    DateTime  @default(now())
  /// The first refusal code, kept even after a later delivery settles.
  firstFailureCode String?
  firstFailureAt   DateTime?
  /// When this event settled. Null while it never has.
  resolvedAt       DateTime?

  @@unique([provider, eventKey])
  @@index([status])
  @@index([purchaseId])
  @@index([createdAt])
}

model SequenceCounter {
  id         String             @id @default(cuid())
  entityType NumberedEntityType
  year       Int
  lastNumber Int                @default(0)
  updatedAt  DateTime           @updatedAt

  @@unique([entityType, year])
  @@index([entityType])
}

model ProviderCreditTransaction {
  id            String                @id @default(cuid())
  providerId    String
  type          CreditTransactionType
  amount        Int
  balanceAfter  Int
  reason        String?
  referenceType String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime              @default(now())

  provider          ProviderProfile         @relation(fields: [providerId], references: [id])
  createdBy         User?                   @relation(fields: [createdById], references: [id])
  manualRefundAudit ManualOfferRefundAudit?

  // A PostgreSQL partial unique index —
  // "ProviderCreditTransaction_one_refund_per_offer", UNIQUE ("referenceId")
  // WHERE type = 'OFFER_REFUND' AND "referenceType" = 'Offer' — is created by
  // the add_unviewed_offer_refund_policy migration. Prisma cannot express
  // partial indexes here, so it lives in raw SQL; it is what makes a second
  // refund of one offer unrepresentable, whatever a retried worker, a parallel
  // run or a future code path attempts.
  @@index([providerId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

/// The record of an administrator giving a credit back by hand.
///
/// Manual refund is an operations tool, not the product's refund policy. The
/// policy — a credit returns when the customer never opened the offer inside 48
/// hours — is what providers are promised and what the worker performs; this is
/// the escape hatch for the cases an automatic rule cannot see, such as a
/// request that turned out to be invalid. Nothing customer-facing mentions it,
/// and it uses its own ledger reason so a report can always tell the two apart.
///
/// The row is mandatory: the service writes it in the same transaction as the
/// ledger entry and the offer update, so a manual refund without an operator's
/// name on it cannot exist. `performedById` is non-nullable for the same
/// reason — an operations action with no operator is not an audit record.
model ManualOfferRefundAudit {
  id                  String   @id @default(cuid())
  /// UNIQUE, and that is the point: this is a second, independent
  /// database-level bar against paying one offer twice, beside the partial
  /// unique index on the ledger itself.
  offerId             String   @unique
  providerId          String
  /// The credit actually returned, snapshotted here rather than read back from
  /// the offer later, so the record stays true whatever happens to the offer.
  creditAmount        Int
  /// The operational reason chosen from the closed list in refund-policy.ts.
  /// Never shown to a provider or a customer.
  reasonCode          String
  /// The operator's free-text note. May carry internal detail, so it is read by
  /// admin surfaces only and never reaches an outbound message.
  note                String?
  performedById       String
  /// The ledger row this refund wrote, so the money and its justification are
  /// one another's counterpart rather than two rows a reader has to correlate.
  creditTransactionId String   @unique
  createdAt           DateTime @default(now())

  offer             Offer                     @relation(fields: [offerId], references: [id])
  provider          ProviderProfile           @relation(fields: [providerId], references: [id])
  performedBy       User                      @relation("ManualOfferRefundPerformedBy", fields: [performedById], references: [id])
  creditTransaction ProviderCreditTransaction @relation(fields: [creditTransactionId], references: [id])

  @@index([providerId])
  @@index([performedById])
  @@index([createdAt])
}

model CustomerNote {
  id          String   @id @default(cuid())
  customerId  String
  note        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  User  @relation("CustomerNoteCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CustomerNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([createdById])
  @@index([createdAt])
}

model CustomerActivationToken {
  id          String    @id @default(cuid())
  customerId  String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  customer  User  @relation("CustomerActivationTokenCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CustomerActivationTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([createdById])
  @@index([expiresAt])
}

model AdminInviteToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  user      User  @relation("AdminInviteTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AdminInviteTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdById])
  @@index([expiresAt])
}

/// A one-time invitation to take ownership of a guest provider application.
///
/// The token is bound to the application, not to an account: at the moment it
/// is issued the applicant may have no platform account at all. What ties it to
/// a person is `emailSnapshot` — the application's contact address as it stood
/// when the link was mailed. If the address is later corrected, the snapshot no
/// longer matches and every outstanding link for that application is dead,
/// which is what stops a link mailed to the wrong address from staying usable.
///
/// The raw token is never stored: only `sha256(raw)`, so a database dump cannot
/// be replayed into an ownership grant. It is single use (`usedAt`), and
/// issuing a new one closes every older live one, so at most one link per
/// application is ever valid.
model ProviderClaimToken {
  id            String    @id @default(cuid())
  providerId    String
  tokenHash     String    @unique
  /// Lower-cased copy of ProviderProfile.email at issue time. Compared against
  /// the live value on every use; a mismatch invalidates the token.
  emailSnapshot String
  expiresAt     DateTime
  usedAt        DateTime?
  /// The admin who re-sent the invitation, or NULL when the application's own
  /// submission issued it.
  createdById   String?
  createdAt     DateTime  @default(now())

  provider  ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("ProviderClaimTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([createdById])
  @@index([expiresAt])
  /// Per-application send budget: "links issued for this application since
  /// <cutoff>".
  @@index([providerId, createdAt])
}

/// A one-time link that lets somebody who proved mailbox control set a new
/// password.
///
/// The raw token is never stored: only `sha256(raw)`, so a database dump cannot
/// be replayed into an account takeover. It is single use (`usedAt`), short
/// lived, and issuing a new one closes every older live one — so at most one
/// reset link per account is ever valid.
///
/// Deliberately separate from CustomerActivationToken. That token sets the
/// *first* password on an account the platform created on somebody's behalf and
/// only exists while `passwordHash` is NULL; this one replaces an existing
/// password on an account that already has one. Two different facts, two
/// different lifecycles, and no row can ever satisfy both.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  /// Per-account send budget: "reset links issued for this account since
  /// <cutoff>".
  @@index([userId, createdAt])
}

/// A one-time link proving that the person who registered controls the address
/// they registered with.
///
/// Same storage rules as PasswordResetToken: hashed, single use, expiring, and
/// superseded by the next one issued.
///
/// `emailSnapshot` is the address the link was mailed to, lower-cased. It is
/// compared against the account's live address on use, so a link that went to an
/// address the account no longer has cannot verify the new one — the same rule
/// ProviderClaimToken applies for the same reason.
model EmailVerificationToken {
  id            String    @id @default(cuid())
  userId        String
  emailSnapshot String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  /// Per-account send budget.
  @@index([userId, createdAt])
}

/// The one conversation a match is allowed to have.
///
/// A thread is not a container somebody opens; it is the shadow of a completed
/// match. It exists only where the whole chain holds — the request is MATCHED,
/// `matchedOfferId` names this offer, a ContactRevealEvent for that pair is on
/// file, the request belongs to a signed-in customer and the winning provider
/// profile belongs to a platform account — and it is created lazily the first
/// time one of those two people opens messaging. Nothing else can bring one
/// into existence, so a losing, withdrawn, rejected or pending offer has no
/// thread to find and no id to guess.
///
/// `requestId` and `offerId` are both unique. One customer match, one thread,
/// forever: a second conversation on the same job is unrepresentable rather
/// than merely refused, and the offer key means a thread can never be
/// re-pointed at a different winner.
///
/// The two participant columns are denormalised copies of what the chain
/// already says, and they are what every authorization query keys on. That is
/// deliberate: authorization asks "is the caller this thread's customer or this
/// thread's provider account", never "does the caller know the thread id".
model MessageThread {
  id             String @id @default(cuid())
  requestId      String @unique
  offerId        String @unique
  /// The customer's account. Not nullable: a guest request has nobody to sign
  /// in as, so it gets no thread at all rather than a half of one.
  customerUserId String
  providerId     String
  /// The account that owns the winning provider profile. Not nullable for the
  /// same reason: an unclaimed profile has no person behind it to message.
  providerUserId String

  /// When the last message landed. NULL for a thread nobody has written in yet,
  /// which is a real state and reads as an empty conversation, not a missing one.
  lastMessageAt      DateTime?
  /// Per-participant read marks. The counterpart is shown only whether their
  /// last message has been read — never when, from where, or on what device.
  customerLastReadAt DateTime?
  providerLastReadAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  request      ServiceRequest  @relation(fields: [requestId], references: [id])
  offer        Offer           @relation(fields: [offerId], references: [id])
  customer     User            @relation("MessageThreadCustomer", fields: [customerUserId], references: [id])
  provider     ProviderProfile @relation(fields: [providerId], references: [id])
  providerUser User            @relation("MessageThreadProviderUser", fields: [providerUserId], references: [id])
  messages     Message[]

  /// Both inbox queries: "my threads, most recent first".
  @@index([customerUserId, lastMessageAt])
  @@index([providerUserId, lastMessageAt])
  @@index([providerId])
}

/// One plain-text message. Immutable: there is no edit and no delete in this
/// version, so a row here is the permanent record of what was actually said.
///
/// `body` is stored exactly as the sender typed it (trimmed, length-capped) and
/// is never HTML. Every surface renders it as text.
model Message {
  id           String            @id @default(cuid())
  threadId     String
  senderUserId String
  senderRole   MessageSenderRole
  body         String
  /// The client's idempotency key for this send.
  ///
  /// A double-submitted form — the second click, the retried action, the
  /// refreshed tab — carries the key the first one did, and the unique index
  /// below turns the duplicate into "you already sent this" rather than a
  /// second identical message. NULL is allowed and PostgreSQL treats NULLs as
  /// distinct, so a caller that supplies no key simply gets no protection
  /// rather than colliding with every other keyless message.
  ///
  /// The key is scoped to the sender as well as the thread. Two people writing
  /// in one conversation pick their keys independently, so a shared value has
  /// to mean two different messages — scoping it to the thread alone would let
  /// one party's send silently return the other party's message.
  clientToken  String?
  createdAt    DateTime          @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id])
  sender User          @relation("MessageSender", fields: [senderUserId], references: [id])

  @@unique([threadId, senderUserId, clientToken])
  /// The only ordering this feature has, and the cursor pagination that reads
  /// it: (createdAt, id) ascending, so two messages written in the same
  /// millisecond still have exactly one order.
  @@index([threadId, createdAt, id])
  @@index([senderUserId, createdAt])
}

/// A single-use invitation to apply as a provider for one specific service.
///
/// It exists because the marketplace has to be able to recruit supply for a
/// service it has not released yet. A DRAFT category is invisible everywhere a
/// business could find it — the public catalogue, the application form's
/// category list, provider discovery — so before this the only way to put a
/// provider behind an unreleased service was for an operator to create the
/// application themselves and bind it by hand. This is the applicant-facing
/// half of that: the operator produces a link, hands it to one business, and
/// that business fills in its own application.
///
/// What the link is NOT is a widening of the catalogue. It names exactly one
/// category, to exactly one holder, once. Nothing about it makes a DRAFT
/// category public: the only fact it discloses is that category's name, and
/// only to whoever holds the link.
///
/// The raw token is never stored — only `sha256(raw)` — so a database dump
/// cannot be replayed into an application against an unreleased service. It is
/// single use (`usedAt`), revocable (`revokedAt`) and short lived
/// (`expiresAt`); those three plus "no such row" are one indistinguishable
/// answer to whoever holds the URL, because distinguishing them would turn the
/// public route into an oracle for guessed tokens.
///
/// Deliberately unlike ProviderClaimToken in one respect: issuing a new
/// invitation does NOT close the older live ones. A claim token is the single
/// key to one application's ownership, so at most one may live; an invitation
/// is a recruiting link, and an operator sending one to five businesses for the
/// same draft is the ordinary case rather than a mistake.
model ProviderInviteToken {
  id          String    @id @default(cuid())
  categoryId  String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// When an operator withdrew the link, and never for any other reason.
  /// Separate from `usedAt` on purpose: "somebody applied with this" and "we
  /// changed our mind" are different facts, and collapsing them would make the
  /// admin list unable to say which happened.
  revokedAt   DateTime?
  /// The SUPER_ADMIN who issued it. NULL only if that account is later deleted.
  createdById String?
  createdAt   DateTime  @default(now())

  category  ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("ProviderInviteTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// The admin list: "this category's invitations, newest first".
  @@index([categoryId, createdAt])
  @@index([createdById])
  @@index([expiresAt])
}

/// One account's request for help from the platform itself.
///
/// Deliberately unlike MessageThread, which is the shadow of a match between
/// two parties of the marketplace. A ticket is between one account and the
/// operator, so it has exactly one owner and no second participant column: the
/// other side is "whichever SUPER_ADMIN answered", and which one is recorded on
/// each message rather than on the ticket. Nothing here can be reassigned to a
/// different owner — `requesterId` is written once, from the authenticated
/// principal, and no endpoint accepts it as input.
///
/// The owner is a `User` rather than a customer. It always was — the column
/// pointed at `User` from the first migration — but it was named `customerId`
/// and every query around it assumed the CUSTOMER role, so opening the desk to
/// hizmet verenler was a rename of the column and a new snapshot beside it
/// rather than a second table. One table means one queue for the operator, one
/// transition rule, one timeline shape and one set of notifications; two would
/// have meant two of each, drifting.
///
/// The opening message is **not** a column on this row. It is written as the
/// ticket's first SupportTicketMessage inside the same transaction, so the
/// conversation is one ordered list from the first sentence onwards rather than
/// a column that every reader has to remember to prepend. The create endpoint
/// still requires it, so a ticket with no message is unrepresentable in
/// practice.
///
/// Nothing is ever deleted: there is no delete endpoint, and the foreign keys
/// below are RESTRICT, so an account with a ticket cannot be removed out from
/// under it either.
model SupportTicket {
  id          String @id @default(cuid())
  /// The account that owns this ticket. Every authorization query keys on this
  /// column and never on the URL's id, so knowing a ticket id gets a stranger
  /// nothing.
  requesterId String

  /// Which side of the marketplace opened it, frozen at the moment it was
  /// opened.
  ///
  /// No `@default`: a ticket without a side is not a state this table should be
  /// able to hold, and a default would let a future create path forget to say
  /// which desk it belongs to and quietly file a provider's ticket as a
  /// customer's. The migration that added the column defaulted it to CUSTOMER
  /// to fill the rows that already existed — every one of which really was a
  /// customer's — and then dropped the default for exactly this reason.
  ///
  /// It is the second half of every ownership predicate, next to `requesterId`.
  /// One account holds one role so the id alone would already be enough today;
  /// carrying the role too means the day an account's role changes, its old
  /// tickets stay on the desk they were opened at instead of following it.
  requesterRole SupportTicketRequesterRole
  subject       String
  status        SupportTicketStatus        @default(OPEN)

  /// When something last happened on this ticket — a message from either side,
  /// or a status change.
  ///
  /// Separate from `updatedAt`, which Prisma moves on every write including
  /// ones that are not activity. It is the admin list's "son hareket" column
  /// and its default sort, and it only ever moves forwards: the writes that
  /// touch it are guarded on `lastActivityAt < now`, so two concurrent replies
  /// cannot leave the ticket claiming the older of the two moments.
  lastActivityAt DateTime @default(now())

  /// When an operator marked the ticket resolved, and null again if it went
  /// back to being worked. Two columns rather than one "closed" flag, because
  /// "we think this is answered" and "this is over" are different facts and the
  /// timeline has to be able to say which happened when.
  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  requester     User                        @relation("SupportTicketRequester", fields: [requesterId], references: [id])
  messages      SupportTicketMessage[]
  statusChanges SupportTicketStatusChange[]

  /// The owner's own list: "my tickets, most recent activity first".
  @@index([requesterId, lastActivityAt])
  /// The admin list, filtered by status and unfiltered, in that same order.
  @@index([status, lastActivityAt])
  @@index([lastActivityAt])
  /// The admin list narrowed to one side of the marketplace, with and without
  /// the status filter. Two indexes rather than one because the queue is read
  /// both ways: "hizmet verenlerin açık talepleri" and "hizmet verenlerin
  /// tamamı" are both ordinary things for an operator to ask for.
  @@index([requesterRole, status, lastActivityAt])
  @@index([requesterRole, lastActivityAt])
}

/// One plain-text message on a ticket. Immutable: there is no edit and no
/// delete, so a row here is the permanent record of what was actually said.
///
/// `body` is stored exactly as its author typed it (trimmed, control characters
/// stripped, length-capped) and is never HTML. Every surface renders it as
/// text.
model SupportTicketMessage {
  id           String                  @id @default(cuid())
  ticketId     String
  /// The account that wrote it — the owner of the ticket, or the SUPER_ADMIN
  /// who answered. Taken from the session, never from the request body.
  authorUserId String
  authorRole   SupportTicketAuthorRole
  body         String
  createdAt    DateTime                @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])
  author User          @relation("SupportTicketMessageAuthor", fields: [authorUserId], references: [id])

  /// The only ordering this feature has, and the one both screens read it in:
  /// (createdAt, id) ascending, so two messages written in the same millisecond
  /// still have exactly one order.
  @@index([ticketId, createdAt, id])
  /// The foreign key's own column. PostgreSQL does not index a referencing
  /// column for you, and RESTRICT means every write to `User` has to check it.
  @@index([authorUserId, createdAt])
}

/// One recorded status transition, kept forever.
///
/// It exists because "the ticket is resolved" is not the same fact as "an
/// operator resolved it at 14:20, having first taken it into progress". Without
/// this table the only status a screen could show is the current one, and the
/// brief asks for status changes and admin messages to be distinguishable on
/// one permanent timeline — which is what merging these rows with the messages
/// above, ordered by `createdAt`, produces.
///
/// It is deliberately not a message: a transition has no body, and giving it
/// one would mean either a nullable body on every real message or a
/// system-written sentence stored as if a person had typed it.
model SupportTicketStatusChange {
  id          String               @id @default(cuid())
  ticketId    String
  /// Null only for a row whose transition had no predecessor, which no
  /// transition this product performs does — the column is nullable so a future
  /// "created as" row would not need a fake origin.
  fromStatus  SupportTicketStatus?
  toStatus    SupportTicketStatus
  /// The SUPER_ADMIN who made the change. Only an admin can, which is why there
  /// is no role column here to disambiguate.
  changedById String
  createdAt   DateTime             @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  changedBy User          @relation("SupportTicketStatusChangedBy", fields: [changedById], references: [id])

  @@index([ticketId, createdAt, id])
  /// The foreign key's own column, for the reason above.
  @@index([changedById, createdAt])
}

/// What a vitrin (showcase) card sells.
///
/// SERVICE names one LEAF service and carries a fixed price for a standard
/// scope: the customer sees a number before they ask for anything. PROMOTION
/// introduces the business itself and carries no price at all — the customer
/// chooses the concrete service later, when the lead flow ships.
///
/// The two are not one type with a nullable price. A card that may or may not
/// have a price would leave every reader — the provider's screen, the admin's
/// review, and the customer surface still to come — deciding for itself what a
/// missing number means. A pair of CHECK constraints on ShowcaseCardVersion
/// pins the price to the kind in both directions instead.
enum ShowcaseCardKind {
  SERVICE
  PROMOTION
}

/// Where a card is in its life, as opposed to where its content is in review.
///
/// The split is the point. `ShowcaseCardVersion.reviewStatus` is about one text;
/// this is about the card the provider owns. An APPROVED card whose newest
/// version is under review is still APPROVED — it has a live version and it goes
/// on serving it — and that is exactly the state a status derived from the
/// newest version could not express.
///
/// DRAFT          — created, never submitted. No live version.
/// PENDING_REVIEW — its first version is with an operator. Still no live version.
/// APPROVED       — has a live version. Stays here while later versions are reviewed.
/// REJECTED       — its first version was refused and it has never had a live one.
/// SUSPENDED      — an operator pulled it. Reserved: nothing publishes a card in
///                  this phase, so nothing reads it yet, and no endpoint writes it.
/// ARCHIVED       — the provider retired it. Reserved for the same reason.
enum ShowcaseCardStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

/// Where one version's content stands.
///
/// DRAFT    — the provider is still writing it. No price-terms acceptance on
///            file yet, which is why `priceTermsVersion` is NULL exactly here.
/// PENDING  — submitted, waiting for an operator.
/// APPROVED — an operator said yes, or the narrowing rule published it (see
///            ShowcaseCardAutoPublishAudit). Either way it is publishable text.
/// REJECTED — an operator said no, with a note. Terminal: the provider edits by
///            creating the next version, never by reopening this one.
enum ShowcaseVersionReview {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

/// A vitrin card's identity and life — never its content.
///
/// Everything a person reads lives on ShowcaseCardVersion, and this row holds
/// two pointers into that history: the version being served and the version
/// being written. Keeping them apart is what lets an approved card stay up
/// while its replacement is in review — the alternative, one "current version",
/// would take a live card down the moment its owner fixed a typo.
model ShowcaseCard {
  id         String             @id @default(cuid())
  providerId String
  /// Fixed at creation and never updated. Changing what a card *is* is not an
  /// edit to a card, it is a different card — and a kind that could change would
  /// let a priced SERVICE become a price-less PROMOTION while a customer was
  /// looking at the price.
  kind       ShowcaseCardKind
  /// A LEAF for a SERVICE card. A LEAF or a GROUP for a PROMOTION card, which
  /// sits on a shelf rather than naming one service. Never a ROUTER: a router is
  /// a question, not a place a business can be listed under.
  categoryId String
  status     ShowcaseCardStatus @default(DRAFT)

  /// The approved version being served. NULL until the first approval, and
  /// never cleared afterwards — a rejection of a later version leaves the card
  /// exactly as it was.
  liveVersionId  String? @unique
  /// The version the provider is writing or has submitted. At most one, which
  /// is what the unique constraint says: a card with two open drafts has two
  /// answers to "what happens when this is approved".
  draftVersionId String? @unique

  /// Reserved for the operator's pull-down. No endpoint writes these in this
  /// phase; they exist so adding that action later is a controller change
  /// rather than a migration on a table that by then has live rows.
  suspendedAt   DateTime?
  suspendReason String?
  archivedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider     ProviderProfile      @relation(fields: [providerId], references: [id])
  category     ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Restrict rather than the implicit SetNull on both pointers: silently
  /// clearing the live version would take a card off the air with nothing on
  /// record to say why. Nothing in the product deletes a version.
  liveVersion  ShowcaseCardVersion? @relation("ShowcaseCardLiveVersion", fields: [liveVersionId], references: [id], onDelete: Restrict)
  draftVersion ShowcaseCardVersion? @relation("ShowcaseCardDraftVersion", fields: [draftVersionId], references: [id], onDelete: Restrict)

  versions              ShowcaseCardVersion[]              @relation("ShowcaseCardVersions")
  autoPublishAudits     ShowcaseCardAutoPublishAudit[]
  withdrawals           ShowcaseSubmissionWithdrawal[]
  purchases             PackagePurchase[]
  placements            ShowcasePlacement[]
  leads                 ShowcaseLead[]
  priceTermsAcceptances ShowcaseCardPriceTermsAcceptance[]
  entitlements          ShowcaseEntitlement[]

  @@index([providerId, status])
  @@index([providerId, createdAt])
  @@index([categoryId, status])
  @@index([status])
}

/// One reviewable, freezable statement of what a card says.
///
/// A version is never edited once it leaves DRAFT. That is what makes
/// `ShowcaseCardReview.cardVersionId` mean something: the row names the exact
/// text an operator read, and no later change can rewrite what was approved.
model ShowcaseCardVersion {
  id            String @id @default(cuid())
  cardId        String
  /// 1, 2, 3 … per card. Ordering history by `createdAt` would tie two versions
  /// written in the same millisecond; this cannot.
  versionNumber Int

  /// The card's kind, copied here so a version is readable on its own — the
  /// admin review screen renders one of these and should not have to join to
  /// find out whether a missing price is a fault or the whole point.
  kindSnapshot ShowcaseCardKind

  title   String
  summary String

  /// What the standard scope includes and what it deliberately does not.
  /// Both are required to be non-empty by a CHECK: a fixed price for an
  /// unstated scope is the fixed price this product must never carry.
  scopeIncluded String[]
  scopeExcluded String[]

  /// The price the provider commits to, in minor units, for a SERVICE card.
  /// NULL for a PROMOTION card, and a CHECK enforces both halves.
  ///
  /// **This is not money TakTick handles.** It is the provider's own price to
  /// their own customer; the platform sells vitrin placement and nothing else,
  /// is not a party to this amount and never settles it. The column is named
  /// apart from `PackagePurchase.priceAmountSnapshot` — which *is* what TakTick
  /// charges — so no reader can confuse the two.
  listedServicePriceAmount Int?
  /// TRY, and a CHECK says so. A second currency is a product decision about
  /// which market this platform serves, not a column that should quietly admit
  /// one.
  listedServiceCurrency    String @default("TRY")

  imageUrl String?

  /// What the provider promises to answer inside, per urgency, once the lead
  /// flow ships. Stored on the version because it is part of what an operator
  /// approves — and because a promise made to a customer must be readable from
  /// the text that made it, not from whatever the card says later.
  responseSlaUrgentHours Int @default(3)
  responseSlaNormalHours Int @default(24)

  /// Which version of the price-responsibility text the provider accepted when
  /// they submitted this one, and when.
  ///
  /// NULL means "no acceptance on file", and that is a real state rather than a
  /// gap: a DRAFT has not been submitted, so nobody has accepted anything for
  /// it. Writing the current version string into a draft would record a consent
  /// that was never given. A CHECK requires both columns on every version that
  /// has left DRAFT, which is what makes "submitted without accepting"
  /// unrepresentable rather than merely refused.
  priceTermsVersion    String?
  priceTermsAcceptedAt DateTime?

  reviewStatus ShowcaseVersionReview @default(DRAFT)
  submittedAt  DateTime?
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card   ShowcaseCard              @relation("ShowcaseCardVersions", fields: [cardId], references: [id], onDelete: Restrict)
  areas  ShowcaseCardVersionArea[]
  review ShowcaseCardReview?

  liveOnCard  ShowcaseCard? @relation("ShowcaseCardLiveVersion")
  draftOnCard ShowcaseCard? @relation("ShowcaseCardDraftVersion")

  autoPublishAudit   ShowcaseCardAutoPublishAudit?    @relation("ShowcaseAutoPublishVersion")
  supersededByAudits ShowcaseCardAutoPublishAudit[]   @relation("ShowcaseAutoPublishPreviousVersion")
  withdrawals        ShowcaseSubmissionWithdrawal[]
  purchases          PackagePurchase[]
  pinnedPlacements   ShowcasePlacement[]
  versionChangesFrom ShowcasePlacementVersionChange[] @relation("ShowcasePlacementVersionFrom")
  versionChangesTo   ShowcasePlacementVersionChange[] @relation("ShowcasePlacementVersionTo")
  leads              ShowcaseLead[]
  entitlementPauses  ShowcaseEntitlementReviewPause[]

  @@unique([cardId, versionNumber])
  @@index([cardId, createdAt])
  /// The operator's queue: "everything waiting, oldest first".
  @@index([reviewStatus, submittedAt])
}

/// One area a version claims, and the only place a card's coverage lives.
///
/// Deliberately hung off the version rather than the card. Coverage is content:
/// it is what an operator approves and what a customer would be shown a card
/// for, so widening it has to go through review like every other change. A card
/// that owned its own areas could have its reach edited underneath an approval.
model ShowcaseCardVersionArea {
  id            String                   @id @default(cuid())
  cardVersionId String
  /// Derived by the API from the levels below, exactly as ProviderServiceArea's
  /// is, and never accepted from a request body.
  scope         ProviderServiceAreaScope
  city          String
  district      String?
  neighborhood  String?

  /// The canonical comparison key: the three levels folded with the same
  /// Turkish-aware rule the location table uses, joined with "|", and using the
  /// empty string — never NULL — for a level this area does not name.
  ///
  /// The empty string is load-bearing. PostgreSQL treats NULLs as distinct in a
  /// unique index, so a key with NULL segments would not bind duplicates at all;
  /// ProviderServiceArea needed three partial indexes to work around exactly
  /// that. One non-null text column needs one ordinary unique index.
  ///
  /// Server-derived. A client posts places, never a key.
  areaKey String

  createdAt DateTime @default(now())

  version ShowcaseCardVersion @relation(fields: [cardVersionId], references: [id], onDelete: Cascade)

  @@unique([cardVersionId, areaKey])
  @@index([cardVersionId])
  @@index([areaKey])
}

/// One operator's decision about one version. Never anything else.
///
/// `reviewedById` is NOT NULL and there is no system actor, which is the whole
/// contract: a row here is a person's decision, and nothing the application does
/// on its own may write one. The narrowing rule that publishes a version without
/// an operator writes ShowcaseCardAutoPublishAudit instead, precisely so that
/// reading this table never turns an automatic step into somebody's judgement.
///
/// Written in the same serializable transaction as the version and card updates
/// it justifies, so a decision without its effect — or an effect without its
/// decision — cannot exist.
model ShowcaseCardReview {
  id            String                @id @default(cuid())
  /// One decision per version. A version leaves PENDING exactly once.
  cardVersionId String                @unique
  decision      ShowcaseVersionReview
  reviewedById  String
  /// Required by the API on a rejection and refused on an approval: a refusal
  /// the provider cannot act on is not a review. Nullable in the column because
  /// an approval genuinely has nothing to say.
  note          String?
  createdAt     DateTime              @default(now())

  version    ShowcaseCardVersion @relation(fields: [cardVersionId], references: [id], onDelete: Restrict)
  reviewedBy User                @relation("ShowcaseCardReviewedBy", fields: [reviewedById], references: [id])

  @@index([reviewedById, createdAt])
  @@index([createdAt])
}

/// The record of a version the system published without an operator.
///
/// There is exactly one such rule: a change that removes areas and alters
/// nothing else. Narrowing your own reach needs no permission — refusing it
/// would mean a provider had to ask an operator before serving fewer people —
/// but it still changes what is live, and a change to live content with nobody's
/// name on it must not be invisible.
///
/// So it is written here rather than as a ShowcaseCardReview with a fabricated
/// reviewer. The two tables answer two different questions, and merging them
/// would make "who approved this" unanswerable for every row.
///
/// `removedAreaKeys` is the evidence, not a summary: the exact keys that went
/// away, so an auditor can see what was narrowed without reconstructing it from
/// two versions' area lists.
/// One provider pulling one submission back out of the review queue.
///
/// A submission is not a decision, and withdrawing it is not one either — so
/// this is not a `ShowcaseCardReview`. That table's `reviewedById` is NOT NULL
/// precisely so every row in it is a person's judgement about a text; a
/// withdrawal has no reviewer, and inventing one would make "who decided this"
/// unanswerable for every row beside it.
///
/// Append-only, and deliberately as small as the question it answers: which
/// provider pulled which submission back, and when. Nothing about the card's
/// content is copied here — the version still holds all of it.
///
/// `cardVersionId` is **not** unique. One version may be submitted, withdrawn,
/// corrected, submitted again and withdrawn again; each of those is a separate
/// event and the second must not overwrite the first.
///
/// `submittedAtSnapshot` is what tells two such rows apart. Withdrawing clears
/// the version's own `submittedAt` — that is the point of it — so without this
/// copy the record of *which* submission was pulled would be destroyed by the
/// act of pulling it.
model ShowcaseSubmissionWithdrawal {
  id                  String   @id @default(cuid())
  cardVersionId       String
  cardId              String
  providerId          String
  /// The moment the withdrawn submission was made, copied before it is cleared.
  submittedAtSnapshot DateTime
  createdAt           DateTime @default(now())

  version  ShowcaseCardVersion @relation(fields: [cardVersionId], references: [id], onDelete: Restrict)
  card     ShowcaseCard        @relation(fields: [cardId], references: [id], onDelete: Restrict)
  provider ProviderProfile     @relation(fields: [providerId], references: [id])

  @@index([cardId, createdAt])
  @@index([providerId, createdAt])
  @@index([cardVersionId, createdAt])
}

model ShowcaseCardAutoPublishAudit {
  id                String   @id @default(cuid())
  /// The version that went live. One audit row per version.
  cardVersionId     String   @unique
  cardId            String
  /// The version it replaced. Not nullable: this rule only ever fires on a card
  /// that already had a live version to narrow.
  previousVersionId String
  /// The provider whose action this was. Copied here rather than read through
  /// the card, so the record of who acted survives independently of the card row.
  providerId        String
  /// The area keys the new version dropped. Never empty — a change that removes
  /// nothing is not a narrowing and does not reach this path.
  removedAreaKeys   String[]
  createdAt         DateTime @default(now())

  version         ShowcaseCardVersion @relation("ShowcaseAutoPublishVersion", fields: [cardVersionId], references: [id], onDelete: Restrict)
  previousVersion ShowcaseCardVersion @relation("ShowcaseAutoPublishPreviousVersion", fields: [previousVersionId], references: [id], onDelete: Restrict)
  card            ShowcaseCard        @relation(fields: [cardId], references: [id], onDelete: Restrict)
  provider        ProviderProfile     @relation(fields: [providerId], references: [id])

  @@index([cardId, createdAt])
  @@index([providerId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Vitrin, phase two: the catalogue, the paid placement, and the direct lead.
//
// Phase one shipped a card: a reviewed text that nothing rendered and nobody
// paid for. This is what turns it into a product — an operator's package, a
// provider's payment, a bounded run on the home page, and a lead that reaches
// exactly one business with a clock on it.
//
// Three separations run through everything below and each one is load-bearing:
//
//  1. **The catalogue is separate; the money rail is not.** ShowcasePackage is
//     its own table because a vitrin package is never an offering right, and
//     the enum that decides offering rights is read on the offer hot path. But
//     the payment is still a PackagePurchase, because `providerOrderId` unique
//     on one table is what makes one Lemon order settle one purchase.
//  2. **What was sold is snapshotted; what is shown is not.** A placement
//     freezes the price, the duration and the package name it was sold under,
//     and re-reads none of them from the catalogue afterwards. Its *content*
//     is the opposite: it points at a version and shows whatever that version
//     says, so a card's own page and the home page can never disagree.
//  3. **Response urgency and job urgency are different facts.**
//     `ShowcaseLead.urgencyBucket` is how fast the customer expects an answer;
//     `ServiceRequest.urgency` is when they want the work done. No code path
//     derives one from the other, in either direction.
// ────────────────────────────────────────────────────────────────────────────

/// What a PackagePurchase bought.
///
/// The default is OFFER_PACKAGE because that is what every row in the table
/// meant before vitrin existed — so the column's default is the whole of its
/// backfill, and no existing purchase changed meaning when it appeared.
enum PackagePurchaseKind {
  OFFER_PACKAGE
  SHOWCASE_PACKAGE
}

/// Where a paid placement stands.
///
/// PENDING_ACTIVATION exists for the instant between the payment settling and
/// the placement going live, both of which happen in one transaction. It is a
/// state a reader can hold rather than one they can observe for long, and it
/// is in the "live" set of the one-per-card unique index precisely so a second
/// checkout cannot slip through that instant.
///
/// SUSPENDED is "paid for but not on the air". Whether the clock stops while it
/// is there depends on *why* — see ShowcasePlacementSuspendReason.
///
/// No reader trusts this column on its own. Every publish query also asks
/// `startAt <= now < endAt`, exactly as `isEntitlementUsable` does, so a
/// stopped sweeper cannot buy anybody an extra day of visibility.
enum ShowcasePlacementStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

/// Why a placement is off the air — and, by the table below, whether its paid
/// time keeps running while it is.
///
/// The split is one sentence: **the platform's own obstacles stop the clock;
/// the provider's own actions do not.** A provider who could stop the clock by
/// archiving their card could park a placement indefinitely and spend it when
/// the season suited them, which is buying a run and using it as a voucher.
///
/// | reason                   | clock  | why                                      |
/// |--------------------------|--------|------------------------------------------|
/// | ADMIN_ACTION             | stops  | we pulled it; they could not use the day |
/// | CATEGORY_CLOSED          | stops  | we closed the shelf; nothing of theirs   |
/// | SYSTEM_PUBLISH_BLOCK     | stops  | our fault, not billed to them            |
/// | CARD_ARCHIVED            | runs   | their own decision                       |
/// | AREA_NO_LONGER_COVERED   | runs   | narrowing must not freeze time           |
/// | PROVIDER_NOT_APPROVED    | runs   | a sanction is not rewarded with credit   |
///
/// The verdict is computed by `suspensionExtendsClock` and then **copied** onto
/// each suspension row, never re-derived. If the policy changes, what happened
/// to a placement last March must not change with it.
enum ShowcasePlacementSuspendReason {
  ADMIN_ACTION
  CATEGORY_CLOSED
  SYSTEM_PUBLISH_BLOCK
  CARD_ARCHIVED
  AREA_NO_LONGER_COVERED
  PROVIDER_NOT_APPROVED
}

/// Why a placement moved to a different version of its card.
///
/// Both triggers are somebody's decision about live content — an operator's
/// approval, or the provider's own narrowing — which is why re-pinning happens
/// at all: the alternative is the home page showing text the card's own page no
/// longer says.
enum ShowcaseVersionChangeTrigger {
  ADMIN_APPROVAL
  AREA_NARROWING
}

/// How fast the customer expects to hear back — their own explicit choice on
/// the card's call to action, and nothing else.
///
/// Not derived from `ServiceRequest.urgency`, in either direction. That field
/// says when the work is wanted ("bugün", "bu hafta"); this says how long the
/// customer is prepared to wait for a reply, and a same-day job is very often
/// one somebody is happy to be called about tomorrow.
enum ShowcaseLeadUrgency {
  URGENT
  NORMAL
}

/// Where a direct lead stands.
///
/// OPEN              — the clock is running and only the card owner can see it.
/// ANSWERED          — the card owner offered inside the window.
/// BREACHED          — the window closed with no offer; the customer has been
///                     asked what to do and nothing has been opened up.
/// RELEASED          — the customer said yes; the gate is cleared and the
///                     request enters ordinary moderation.
/// CLOSED_UNANSWERED — it ended without reaching the market: the customer kept
///                     it closed, cancelled, never answered, or an operator
///                     refused the request.
enum ShowcaseLeadStatus {
  OPEN
  ANSWERED
  BREACHED
  RELEASED
  CLOSED_UNANSWERED
}

/// What the customer decided after a breach. There is no third option and no
/// default: silence is handled by a timeout that produces CLOSED_UNANSWERED,
/// never a RELEASE.
enum ShowcaseLeadFallbackDecision {
  RELEASE
  KEEP_CLOSED
}

enum ShowcaseLeadCloseReason {
  CUSTOMER_KEPT_CLOSED
  CUSTOMER_CANCELLED
  MODERATION_REJECTED
  REQUEST_EXPIRED
}

/// Where a purchased vitrin publication right stands.
///
/// AVAILABLE — paid for, bound to no card yet. Usable while `expiresAt > now`.
/// RESERVED  — bound to exactly one card that has not been published yet.
///             Usable while `expiresAt > now` OR the card is under review
///             (`reviewPausedAt IS NOT NULL`): review time is the operator's,
///             and it must never cost the provider their right.
/// CONSUMED  — the card was approved and its placement was born. Terminal.
/// EXPIRED   — the activation window closed before the card went live.
///             Written by the sweeper as a query optimisation; every reader
///             checks the window itself, exactly as placements do.
enum ShowcaseEntitlementStatus {
  AVAILABLE
  RESERVED
  CONSUMED
  EXPIRED
}

/// How one review pause on a right ended. Copied onto the pause row so the
/// history of a right is readable without replaying the card's reviews.
enum ShowcaseEntitlementPauseEnd {
  REJECTED
  WITHDRAWN
  RELEASED
  CONSUMED
}

/// What an operator sells: a run of vitrin visibility, for a fixed price and a
/// fixed number of days.
///
/// **Deliberately not a fourth `OfferPackageType`.** Three things made that the
/// wrong shape. `OfferCreditPackage` carries CHECK constraints that pair the
/// three existing types with their NULL columns, and a fourth would mean
/// loosening guarantees the other three depend on. `OfferPackageType` is read
/// on the offer hot path by the entitlement resolver, and a vitrin package is
/// never an offering right — one missed `switch` branch there is a vitrin
/// purchase quietly granting offer capacity. And
/// `ProviderPackageEntitlementScope` means "may offer in this category", which
/// is meaningless for a placement.
///
/// The slug must begin with `vitrin-`, and `OfferCreditPackage.slug` must not —
/// two CHECK constraints, in two migrations. The reason is a configuration
/// hazard rather than tidiness: `LEMON_SQUEEZY_VARIANT_MAP` is keyed by slug
/// across both catalogues, so without the prefix rule one map entry could serve
/// a credit package and a vitrin package at once and nothing in the database
/// would see it.
model ShowcasePackage {
  id                    String            @id @default(cuid())
  name                  String
  /// `vitrin-` prefixed, and a CHECK says so. See the note above.
  slug                  String            @unique
  /// Minor units, and what TakTick actually charges. Never comparable with
  /// `ShowcaseCardVersion.listedServicePriceAmount`, which is the provider's
  /// own price to their own customer and money this platform never touches.
  priceAmount           Int
  currency              String            @default("TRY")
  /// How long one purchased run lasts, in whole days. Snapshotted onto the
  /// purchase and again onto the placement, so repricing or reshaping a package
  /// cannot lengthen or shorten a run somebody already paid for.
  durationDays          Int
  /// Which card kind this package may be bought for. NULL means either.
  allowedCardKind       ShowcaseCardKind?
  /// The largest number of areas one placement bought with this package may
  /// publish. NULL means every area the pinned version claims.
  maxAreas              Int?
  /// Reserved, and shipped today at `false` deliberately: a placement needs no
  /// second approval, because the card's text is already approved and a second
  /// read would be an operator re-reading their own decision while the provider
  /// waits after paying. It exists so that deciding otherwise for a
  /// high-priced package later is a controller change rather than a migration
  /// against a table that by then has live rows.
  requiresAdminApproval Boolean           @default(false)
  /// How many days after payment an unused right stays claimable. The right is
  /// consumed when the card is first approved; until then this is the clock —
  /// paused while the card is under review, because that time is the
  /// operator's, not the provider's. Snapshotted onto the entitlement as
  /// `expiresAt`, so reshaping the package cannot shorten a right already sold.
  activationWindowDays  Int               @default(90)
  description           String?
  isActive              Boolean           @default(true)
  sortOrder             Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  purchases    PackagePurchase[]
  placements   ShowcasePlacement[]
  entitlements ShowcaseEntitlement[]

  @@index([isActive, sortOrder])
}

/// One paid run of one card on the home page.
///
/// Born from a settled payment and from nothing else: there is no endpoint that
/// creates a placement, no endpoint that extends one, and no endpoint that
/// deletes one. Time is sold, not granted — the only thing that ever moves
/// `endAt` forward is `resume()` paying back a clock-stopping suspension, and
/// even an operator cannot type a new date.
///
/// ## Why `pinnedVersionId` follows the card
///
/// The placement pins whatever version was live when the payment settled. When
/// that changes — an operator approves a new version, or the narrowing rule
/// publishes one — the placement is re-pinned **in the same transaction** and a
/// ShowcasePlacementVersionChange row records it. Either way a person decided
/// the new text should be live, and a placement still serving the old one would
/// mean the card's own page and the home page were saying different things.
/// Content has one source: the version. The placement shows it, never copies it.
///
/// ## Why the SLA is not copied here
///
/// The promise is made to a customer at the moment a lead is opened, and it
/// freezes on `ShowcaseLead`. A copy on the placement would be a second answer
/// to the same question, going stale the first time a version changed.
model ShowcasePlacement {
  id                String           @id @default(cuid())
  /// The payment that produced this run. Unique: one settled payment can never
  /// produce two placements — the same guarantee, and the same mechanism, as
  /// `ProviderPackageEntitlement.purchaseId`.
  purchaseId        String           @unique
  providerId        String
  showcasePackageId String
  cardId            String
  /// The version being published right now. Restrict, because it is the record
  /// of what is on the air.
  pinnedVersionId   String
  /// Denormalised from the card so the publish query can filter without a join.
  /// Safe to copy because a card's category is fixed at creation and no
  /// endpoint changes it.
  categoryId        String
  kindSnapshot      ShowcaseCardKind

  packageNameSnapshot  String
  priceAmountSnapshot  Int
  currencySnapshot     String @default("TRY")
  durationDaysSnapshot Int

  /// The price-responsibility terms this run was sold under: the version the
  /// buyer had accepted when they opened the checkout, and the exact sentence
  /// that version stood for.
  ///
  /// Copied at settlement from the acceptance named on the purchase, and never
  /// re-read from `SHOWCASE_PRICE_TERMS_VERSION` afterwards. This is the
  /// snapshot rule applied to a legal statement rather than to a price: a run
  /// bought under v1 keeps showing v1's sentence to every customer who writes
  /// to it, including after the platform has moved on to v2. Deriving the text
  /// from the current constant would mean a bump silently rewriting what a
  /// customer was told about a placement bought weeks earlier.
  ///
  /// The text is stored beside the version rather than looked up from it, so a
  /// customer-facing read is one row — and so the sentence survives the
  /// constant being edited in a later deploy.
  priceTermsVersionSnapshot String
  priceTermsTextSnapshot    String

  startAt DateTime
  endAt   DateTime

  status          ShowcasePlacementStatus         @default(PENDING_ACTIVATION)
  /// Non-NULL means "not on the air right now". Paired with `suspendReason`,
  /// and a CHECK insists both are set together or neither is.
  suspendedAt     DateTime?
  suspendReason   ShowcasePlacementSuspendReason?
  /// How much time in total has been given back for clock-stopping
  /// suspensions. Written only by `resume()`, only for reasons that stop the
  /// clock, and kept as its own column so "this run was extended" is a fact an
  /// operator can read without replaying the suspension history.
  totalExtendedMs Int                             @default(0)
  cancelledAt     DateTime?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  purchase      PackagePurchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  provider      ProviderProfile     @relation(fields: [providerId], references: [id])
  package       ShowcasePackage     @relation(fields: [showcasePackageId], references: [id], onDelete: Restrict)
  card          ShowcaseCard        @relation(fields: [cardId], references: [id], onDelete: Restrict)
  pinnedVersion ShowcaseCardVersion @relation(fields: [pinnedVersionId], references: [id], onDelete: Restrict)
  category      ServiceCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  shelves        ShowcasePlacementShelf[]
  suspensions    ShowcasePlacementSuspension[]
  versionChanges ShowcasePlacementVersionChange[]
  leads          ShowcaseLead[]
  entitlement    ShowcaseEntitlement?

  // A PostgreSQL partial unique index — "ShowcasePlacement_one_live_per_card",
  // UNIQUE ("cardId") WHERE status IN ('PENDING_ACTIVATION','ACTIVE','SUSPENDED')
  // — is created by the add_showcase_placements migration. It is NOT an
  // anti-boost rule: a provider may open as many cards as they like and buy a
  // package for each. It says only that one card's single slot cannot be sold
  // twice at once, because the second payment would add nothing to what the
  // first one already publishes.

  @@index([providerId, status, endAt])
  @@index([status, endAt])
  @@index([categoryId, status, endAt])
  @@index([pinnedVersionId])
}

/// One (category, area) pair a placement publishes into — the home page's index.
///
/// Derived from the pinned version's own areas and refreshed, in the same
/// transaction, whenever the placement is re-pinned. It exists so the feed is an
/// index lookup rather than a coverage scan: a visitor in
/// İstanbul/Kadıköy/Moda produces exactly three candidate keys and the query
/// asks `areaKey IN (…)`. `ProviderServiceArea` is the counter-example — request
/// matching pulls every area a provider holds and filters them in JavaScript,
/// which is fine for one provider's panel and unacceptable for a public page.
///
/// **There is deliberately no unique index on (providerId, categoryId,
/// areaKey).** An earlier draft had one, and it would have meant a provider
/// could never publish a second card on the same shelf — cutting off the whole
/// "more cards, more reach" model at the point of sale. Balance is a *ranking*
/// problem and it is solved in the feed query's `provider_rank`, which spreads
/// one provider's cards across successive rounds instead of refusing them.
/// One provider accepting one version of the price-responsibility text, for one
/// card. Append-only.
///
/// ## Why this is a table and not a column
///
/// Phase one already records an acceptance — `ShowcaseCardVersion.priceTerms*`,
/// written when a version is submitted for review. That one is part of the
/// *content* record: it says what the provider agreed to about the text an
/// operator was about to read. It cannot answer the question this table exists
/// for, because it is welded to a version: re-accepting new terms would mean
/// writing to a frozen version — or worse, producing a new one and pushing an
/// approved card back through moderation. Accepting terms is a legal act, not
/// an edit, and it must be possible to perform without touching a single thing
/// a customer sees.
///
/// So the two coexist and neither is derived from the other. This one is what
/// the checkout consults.
///
/// ## Append-only, and what enforces it
///
/// No endpoint updates or deletes a row here, and none ever should: a record of
/// consent that can be edited afterwards is not a record of consent. Re-accepting
/// the same version is idempotent by construction rather than by a code path —
/// `UNIQUE ("cardId", "termsVersion")` means a second attempt cannot insert a
/// second row, so the "one acceptance per card per version" rule holds even if
/// two requests race.
///
/// There is no `updatedAt`, deliberately: a column that could move would suggest
/// the row can.
///
/// ## Why the text is copied
///
/// `termsVersion` alone names a string that lives in a TypeScript constant, and
/// a constant is edited by deploys. An auditor asking "what exactly did this
/// business agree to in March" must not have to check out an old commit. The
/// row carries its own answer.
model ShowcaseCardPriceTermsAcceptance {
  id         String @id @default(cuid())
  /// Denormalised from the card. A card never changes hands, so this cannot
  /// drift; it is here so "everything this business has accepted" is one index
  /// lookup on the operator's screen.
  providerId String
  cardId     String

  /// The version string that was in force — `SHOWCASE_PRICE_TERMS_VERSION` at
  /// the moment of acceptance. Non-empty, and a CHECK says so: an empty version
  /// would be an acceptance of nothing that the checkout might later match
  /// against an equally empty configuration.
  termsVersion      String
  /// The sentence itself, exactly as it was shown.
  termsTextSnapshot String

  /// The account that performed the acceptance. Always a PROVIDER account —
  /// the endpoint refuses every other role, including SUPER_ADMIN, for the same
  /// reason the checkout does: an operator may read a business's screens but
  /// may not agree to terms on its behalf.
  acceptedByUserId String
  acceptedAt       DateTime @default(now())

  provider       ProviderProfile   @relation(fields: [providerId], references: [id])
  card           ShowcaseCard      @relation(fields: [cardId], references: [id], onDelete: Restrict)
  acceptedByUser User              @relation(fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  purchases      PackagePurchase[]

  /// The idempotency rule, in the database rather than in a service: one card,
  /// one acceptance per terms version.
  @@unique([cardId, termsVersion])
  @@index([providerId, acceptedAt])
  @@index([termsVersion, acceptedAt])
}

/// One provider accepting one version of the price-responsibility text, for
/// the package-first flow. Append-only, no `updatedAt`.
///
/// Provider-level rather than card-level, because in this flow there is no card
/// yet when the money moves. `UNIQUE(providerId, termsVersion)` means a
/// provider is asked once per version and never twice — and that a second
/// concurrent acceptance cannot produce a second row. A bump of
/// `SHOWCASE_PRICE_TERMS_VERSION` means no row names the new version, so the
/// next purchase asks again.
model ShowcasePackageTermsAcceptance {
  id                String   @id @default(cuid())
  providerId        String
  termsVersion      String
  termsTextSnapshot String
  acceptedByUserId  String
  acceptedAt        DateTime @default(now())

  provider       ProviderProfile @relation(fields: [providerId], references: [id])
  acceptedByUser User            @relation("ShowcasePackageTermsAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  purchases      PackagePurchase[]

  @@unique([providerId, termsVersion])
  @@index([termsVersion, acceptedAt])
}

/// One paid, not-yet-used right to publish one vitrin card.
///
/// Sits between the payment and the placement: settlement grants it, creating a
/// card reserves it, the operator's first approval consumes it and births the
/// placement in the same transaction. A card cannot be "approved but
/// unpublishable" because approval refuses without a valid reserved right.
///
/// What was sold is snapshotted here (package name, duration, price, terms) and
/// copied onto the placement at consumption; the catalogue is never re-read.
model ShowcaseEntitlement {
  id                String                    @id @default(cuid())
  providerId        String
  /// One settled payment, one right. Unique: a redelivered settlement cannot
  /// grant twice.
  purchaseId        String                    @unique
  showcasePackageId String

  packageNameSnapshot       String
  durationDaysSnapshot      Int
  priceAmountSnapshot       Int
  currencySnapshot          String            @default("TRY")
  allowedCardKindSnapshot   ShowcaseCardKind?
  maxAreasSnapshot          Int?
  priceTermsVersionSnapshot String
  priceTermsTextSnapshot    String

  status    ShowcaseEntitlementStatus @default(AVAILABLE)
  grantedAt DateTime
  /// `grantedAt + activationWindowDays`, moved forward by exactly the time the
  /// card spent under review (see ShowcaseEntitlementReviewPause).
  expiresAt DateTime

  cardId      String?
  reservedAt  DateTime?
  consumedAt  DateTime?
  placementId String?   @unique
  /// Non-NULL while the reserved card is with an operator: the clock is stopped.
  reviewPausedAt     DateTime?
  /// Sum of every closed review pause, in whole seconds. Seconds rather than
  /// milliseconds because a 90-day window in milliseconds does not fit an Int.
  totalPausedSeconds Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider  ProviderProfile    @relation(fields: [providerId], references: [id])
  purchase  PackagePurchase    @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  package   ShowcasePackage    @relation(fields: [showcasePackageId], references: [id], onDelete: Restrict)
  card      ShowcaseCard?      @relation(fields: [cardId], references: [id], onDelete: Restrict)
  placement ShowcasePlacement? @relation(fields: [placementId], references: [id], onDelete: Restrict)
  reviewPauses ShowcaseEntitlementReviewPause[]

  // A partial unique index — "ShowcaseEntitlement_one_reserved_per_card",
  // UNIQUE ("cardId") WHERE status = 'RESERVED' — is created by the migration:
  // one card can hold one reserved right at a time.

  @@index([providerId, status, expiresAt])
  @@index([cardId])
}

/// One interval a reserved right spent with its card under review, and what
/// happened to the right's clock because of it. Append-only, closed once.
///
/// The activation window is the provider's obligation to *submit*; the time an
/// operator takes to decide is not billed to them. So the clock stops when the
/// card enters review and `expiresAt` is pushed forward by the interval when it
/// leaves. `expiresAtBefore/After` record the move, exactly as
/// ShowcasePlacementSuspension records `endAtBefore/After`.
model ShowcaseEntitlementReviewPause {
  id             String                       @id @default(cuid())
  entitlementId  String
  cardVersionId  String
  startedAt      DateTime                     @default(now())
  endedAt        DateTime?
  expiresAtBefore DateTime
  expiresAtAfter  DateTime?
  endReason      ShowcaseEntitlementPauseEnd?
  createdAt      DateTime                     @default(now())

  entitlement ShowcaseEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  version     ShowcaseCardVersion @relation(fields: [cardVersionId], references: [id], onDelete: Restrict)

  // A partial unique index — "ShowcaseEntitlementReviewPause_one_open",
  // UNIQUE ("entitlementId") WHERE "endedAt" IS NULL — is created by the
  // migration: one right is paused for one reason at a time.

  @@index([entitlementId, startedAt])
}

model ShowcasePlacementShelf {
  id           String                   @id @default(cuid())
  placementId  String
  providerId   String
  categoryId   String
  /// The canonical key, produced by `showcaseAreaKey()` and never accepted from
  /// a request body. NOT NULL with empty-string segments, so one ordinary
  /// unique index binds duplicates — see ShowcaseCardVersionArea for the full
  /// reasoning.
  areaKey      String
  scope        ProviderServiceAreaScope
  city         String
  district     String?
  neighborhood String?
  /// Whether this row is on the air. Denormalised from the placement so the
  /// feed's index can be partial, and rewritten in the same transaction as
  /// every status change that affects it.
  active       Boolean                  @default(true)
  /// Denormalised from the placement, so a row that a stopped sweeper left
  /// `active` is still excluded by the feed's own `endAt > now()`.
  endAt        DateTime
  createdAt    DateTime                 @default(now())

  placement ShowcasePlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@unique([placementId, categoryId, areaKey])
  @@index([placementId])
  @@index([providerId])
  @@index([areaKey, categoryId, endAt])
}

/// One interval a placement spent off the air, and what it cost its owner.
///
/// Append-only and never rewritten except to close it. `extendsClock` is copied
/// from `suspensionExtendsClock(reason)` at the moment the suspension opens
/// rather than derived when it closes: the rule may change, and what happened to
/// this placement must not change with it. It is the same snapshot discipline
/// the refund window and the entitlement period already use.
model ShowcasePlacementSuspension {
  id           String                         @id @default(cuid())
  placementId  String
  reason       ShowcasePlacementSuspendReason
  /// Whether this interval pushed `endAt` forward. Snapshotted, not derived.
  extendsClock Boolean
  startedAt    DateTime                       @default(now())
  endedAt      DateTime?
  /// `endAt` as it stood when this suspension opened, and as it stands when it
  /// closes. A CHECK refuses a row where the clock did not stop but the two
  /// differ, so "a provider's own action bought them time" is unrepresentable
  /// rather than merely refused by the service.
  endAtBefore  DateTime
  endAtAfter   DateTime?
  /// The operator, when this was somebody's decision. NULL when the system
  /// acted on a category closing, a card being archived or a profile changing
  /// status — and NULL there is a fact, not a gap.
  actorUserId  String?
  note         String?
  createdAt    DateTime                       @default(now())

  placement ShowcasePlacement @relation(fields: [placementId], references: [id], onDelete: Restrict)
  actor     User?             @relation("ShowcasePlacementSuspendedBy", fields: [actorUserId], references: [id], onDelete: SetNull)

  // A partial unique index — "ShowcasePlacementSuspension_one_open_per_placement",
  // UNIQUE ("placementId") WHERE "endedAt" IS NULL — is created by the
  // migration: a placement can be off the air for one reason at a time.

  @@index([placementId, startedAt])
}

/// One re-pin: the placement moved from one version of its card to another.
///
/// Unique on `(placementId, toVersionId)`, so an approval delivered twice
/// records one move rather than two.
model ShowcasePlacementVersionChange {
  id            String                       @id @default(cuid())
  placementId   String
  fromVersionId String
  toVersionId   String
  trigger       ShowcaseVersionChangeTrigger
  createdAt     DateTime                     @default(now())

  placement   ShowcasePlacement   @relation(fields: [placementId], references: [id], onDelete: Restrict)
  fromVersion ShowcaseCardVersion @relation("ShowcasePlacementVersionFrom", fields: [fromVersionId], references: [id], onDelete: Restrict)
  toVersion   ShowcaseCardVersion @relation("ShowcasePlacementVersionTo", fields: [toVersionId], references: [id], onDelete: Restrict)

  @@unique([placementId, toVersionId])
  @@index([placementId, createdAt])
}

/// A request opened from a vitrin card, and everything about it that is not a
/// request.
///
/// The request itself is an ordinary `ServiceRequest`; what makes it a lead is
/// two columns on that row and this one beside it. This table carries the three
/// facts the request has no place for: which urgency the customer chose, what
/// answer time they were promised, and what they decided when that promise was
/// missed.
///
/// ## The card content is frozen here
///
/// `cardVersionId` and `listedPriceSnapshot` record what the customer actually
/// read. The card may be re-pinned to a newer version an hour later; what the
/// customer was looking at when they wrote to this business does not change.
///
/// ## The SLA is derived on the server, always
///
/// The client sends a bucket and never an hour count. The hours come from the
/// *pinned version's* own `responseSlaUrgentHours` / `responseSlaNormalHours`,
/// which are the numbers the provider committed to and an operator approved, and
/// `slaDueAt` is `createdAt` plus that. The sweeper reads `slaDueAt` and never
/// the live setting, so nothing that changes later can move a promise already
/// made.
///
/// ## Release requires consent, in the database
///
/// `ShowcaseLead_release_needs_decision` refuses a `releasedAt` without
/// `fallbackDecision = 'RELEASE'`. A missed deadline on its own opens nothing:
/// the customer wrote to one business, and handing their request to the market
/// because that business was slow is a decision only they can make.
model ShowcaseLead {
  id                  String           @id @default(cuid())
  /// The request this lead is about. Unique here and unique again as
  /// `ServiceRequest.showcaseLeadId`, so the pairing is one-to-one from both
  /// sides.
  requestId           String           @unique
  placementId         String
  cardId              String
  /// The exact text the customer read, and the price they read on it. Never
  /// re-read from the card.
  cardVersionId       String
  /// The card's kind, copied so the price rule below is expressible on this row
  /// alone. A lead is read by the provider's inbox and by the customer's own
  /// panel, and neither should have to join through two tables to find out
  /// whether a missing price is a fault or the whole point.
  kindSnapshot        ShowcaseCardKind
  /// NULL on a PROMOTION card and required on a SERVICE one; a CHECK enforces
  /// both halves, exactly as the version's own price column does.
  listedPriceSnapshot Int?
  /// The card owner: the one and only provider this lead is addressed to.
  providerId          String

  /// The customer's own choice on the card. See ShowcaseLeadUrgency.
  urgencyBucket    ShowcaseLeadUrgency
  /// The promised answer time in whole hours, read from the pinned version at
  /// creation and frozen.
  slaHoursSnapshot Int
  /// `createdAt + slaHoursSnapshot`. The breach sweeper's only clock.
  slaDueAt         DateTime

  status           ShowcaseLeadStatus @default(OPEN)
  respondedAt      DateTime?
  /// The offer that answered it. Unique: one lead, one response.
  respondedOfferId String?            @unique
  /// When the breach was claimed, by a conditional UPDATE that only matches an
  /// OPEN lead. A card owner who answered in the last second finds the row
  /// already ANSWERED and the sweeper matches nothing — the race is settled by
  /// the database rather than by ordering.
  breachedAt       DateTime?

  fallbackAskedAt   DateTime?
  fallbackDecision  ShowcaseLeadFallbackDecision?
  fallbackDecidedAt DateTime?
  releasedAt        DateTime?

  closedAt    DateTime?
  closeReason ShowcaseLeadCloseReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request        ServiceRequest      @relation("ShowcaseLeadRequest", fields: [requestId], references: [id], onDelete: Restrict)
  requestGate    ServiceRequest?     @relation("ServiceRequestShowcaseLead")
  placement      ShowcasePlacement   @relation(fields: [placementId], references: [id], onDelete: Restrict)
  card           ShowcaseCard        @relation(fields: [cardId], references: [id], onDelete: Restrict)
  cardVersion    ShowcaseCardVersion @relation(fields: [cardVersionId], references: [id], onDelete: Restrict)
  provider       ProviderProfile     @relation(fields: [providerId], references: [id])
  respondedOffer Offer?              @relation("ShowcaseLeadRespondedOffer", fields: [respondedOfferId], references: [id], onDelete: Restrict)

  @@index([providerId, status, slaDueAt])
  @@index([status, slaDueAt])
  @@index([placementId, createdAt])
  @@index([status, breachedAt])
}
