generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CUSTOMER
  PROVIDER
}

enum ServiceRequestQuestionType {
  TEXT
  TEXTAREA
  SELECT
  MULTI_SELECT
  NUMBER
  BOOLEAN
  DATE
  IMAGE
}

enum ServiceRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  name      String?
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRequests ServiceRequest[]

  @@index([role])
  @@index([isActive])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  parentId    String?
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent    ServiceCategory?         @relation("ServiceCategoryTree", fields: [parentId], references: [id])
  children  ServiceCategory[]        @relation("ServiceCategoryTree")
  questions ServiceRequestQuestion[]
  requests  ServiceRequest[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model ServiceRequestQuestion {
  id         String                     @id @default(cuid())
  categoryId String
  key        String
  label      String
  helpText   String?
  type       ServiceRequestQuestionType
  isRequired Boolean                    @default(false)
  options    Json?
  sortOrder  Int                        @default(0)
  isActive   Boolean                    @default(true)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  category ServiceCategory        @relation(fields: [categoryId], references: [id])
  answers  ServiceRequestAnswer[]

  @@unique([categoryId, key])
  @@index([categoryId, isActive, sortOrder])
}

model ServiceRequest {
  id                    String               @id @default(cuid())
  categoryId            String
  customerId            String?
  status                ServiceRequestStatus @default(SUBMITTED)
  customerName          String
  customerPhone         String
  customerEmail         String?
  city                  String
  district              String
  neighborhood          String?
  addressNote           String?
  budgetMin             Int?
  budgetMax             Int?
  preferredDate         DateTime?
  urgency               String?
  description           String?
  qualityScore          Int                  @default(0)
  qualityScoreBreakdown Json?
  moderatedAt           DateTime?
  moderationNote        String?
  rejectionReason       String?
  submittedAt           DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  category ServiceCategory        @relation(fields: [categoryId], references: [id])
  customer User?                  @relation(fields: [customerId], references: [id])
  answers  ServiceRequestAnswer[]

  @@index([categoryId])
  @@index([status])
  @@index([city, district])
  @@index([submittedAt])
}

model ServiceRequestAnswer {
  id            String   @id @default(cuid())
  requestId     String
  questionId    String
  questionKey   String
  questionLabel String
  questionType  String
  value         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  request  ServiceRequest         @relation(fields: [requestId], references: [id])
  question ServiceRequestQuestion @relation(fields: [questionId], references: [id])

  @@unique([requestId, questionId])
  @@index([questionId])
}
