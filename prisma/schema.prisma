generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CUSTOMER
  PROVIDER
}

enum ServiceRequestQuestionType {
  TEXT
  TEXTAREA
  SELECT
  MULTI_SELECT
  NUMBER
  BOOLEAN
  DATE
  IMAGE
}

enum ServiceRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ProviderStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum OfferStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  name      String?
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRequests  ServiceRequest[]
  providerProfiles ProviderProfile[]

  @@index([role])
  @@index([isActive])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  parentId    String?
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent    ServiceCategory?          @relation("ServiceCategoryTree", fields: [parentId], references: [id])
  children  ServiceCategory[]         @relation("ServiceCategoryTree")
  questions ServiceRequestQuestion[]
  requests  ServiceRequest[]
  providers ProviderServiceCategory[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model ServiceRequestQuestion {
  id         String                     @id @default(cuid())
  categoryId String
  key        String
  label      String
  helpText   String?
  type       ServiceRequestQuestionType
  isRequired Boolean                    @default(false)
  options    Json?
  sortOrder  Int                        @default(0)
  isActive   Boolean                    @default(true)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  category ServiceCategory        @relation(fields: [categoryId], references: [id])
  answers  ServiceRequestAnswer[]

  @@unique([categoryId, key])
  @@index([categoryId, isActive, sortOrder])
}

model ServiceRequest {
  id                    String               @id @default(cuid())
  categoryId            String
  customerId            String?
  status                ServiceRequestStatus @default(SUBMITTED)
  customerName          String
  customerPhone         String
  customerEmail         String?
  city                  String
  district              String
  neighborhood          String?
  addressNote           String?
  budgetMin             Int?
  budgetMax             Int?
  preferredDate         DateTime?
  urgency               String?
  description           String?
  qualityScore          Int                  @default(0)
  qualityScoreBreakdown Json?
  moderatedAt           DateTime?
  moderationNote        String?
  rejectionReason       String?
  submittedAt           DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  category ServiceCategory        @relation(fields: [categoryId], references: [id])
  customer User?                  @relation(fields: [customerId], references: [id])
  answers  ServiceRequestAnswer[]
  offers   Offer[]

  @@index([categoryId])
  @@index([status])
  @@index([city, district])
  @@index([submittedAt])
}

model ServiceRequestAnswer {
  id            String   @id @default(cuid())
  requestId     String
  questionId    String
  questionKey   String
  questionLabel String
  questionType  String
  value         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  request  ServiceRequest         @relation(fields: [requestId], references: [id])
  question ServiceRequestQuestion @relation(fields: [questionId], references: [id])

  @@unique([requestId, questionId])
  @@index([questionId])
}

model ProviderProfile {
  id              String         @id @default(cuid())
  userId          String?
  businessName    String
  contactName     String
  phone           String
  email           String?
  taxType         String?
  taxNumber       String?
  city            String
  district        String
  addressNote     String?
  description     String?
  status          ProviderStatus @default(PENDING_REVIEW)
  moderationNote  String?
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user              User?                     @relation(fields: [userId], references: [id])
  serviceCategories ProviderServiceCategory[]
  serviceAreas      ProviderServiceArea[]
  offers            Offer[]

  @@index([status])
  @@index([city])
  @@index([district])
  @@index([phone])
  @@index([email])
}

model ProviderServiceCategory {
  id         String   @id @default(cuid())
  providerId String
  categoryId String
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  @@unique([providerId, categoryId])
  @@index([categoryId])
}

model ProviderServiceArea {
  id           String   @id @default(cuid())
  providerId   String
  city         String
  district     String?
  neighborhood String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id])

  @@unique([providerId, city, district, neighborhood])
  @@index([city])
  @@index([district])
}

model Offer {
  id                      String      @id @default(cuid())
  requestId               String
  providerId              String
  status                  OfferStatus @default(SUBMITTED)
  priceAmount             Int
  currency                String      @default("TRY")
  estimatedStartDate      DateTime?
  estimatedCompletionDate DateTime?
  message                 String
  warrantyNote            String?
  internalNote            String?
  submittedAt             DateTime    @default(now())
  viewedAt                DateTime?
  acceptedAt              DateTime?
  rejectedAt              DateTime?
  withdrawnAt             DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  request  ServiceRequest  @relation(fields: [requestId], references: [id])
  provider ProviderProfile @relation(fields: [providerId], references: [id])

  @@unique([providerId, requestId])
  @@index([requestId])
  @@index([providerId])
  @@index([status])
  @@index([submittedAt])
}
